---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_PALETTE, buildThemeCss, defaultPalette, palettes, themeColors } from '../themes';
import { links, profile } from '../data/profile';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/motion.css';

export type NavKey = 'inicio' | 'projetos' | 'erro';

interface Props {
  title: string;
  description: string;
  current?: NavKey;
  /** A página começa com um bloco de cor no topo e o cabeçalho fica transparente sobre ele. */
  overlayHeader?: boolean;
}

const { title, description, current = 'inicio', overlayHeader = false } = Astro.props;
const site = Astro.site ?? new URL('https://seinenk.github.io');
const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(path, site).href;
// O endereço da imagem de compartilhamento leva um código tirado do próprio arquivo. Quando a
// imagem muda, o endereço muda junto, e as redes que guardam a prévia pelo endereço (como o
// Facebook) baixam a nova.
const ogVersion = createHash('sha256')
  .update(readFileSync(join(process.cwd(), 'public', 'og-image.jpg')))
  .digest('hex')
  .slice(0, 8);
const ogImage = new URL(`/og-image.jpg?v=${ogVersion}`, site).href;
const themeCss = buildThemeCss();
const boot = {
  ids: palettes.map((p) => p.id),
  fallback: DEFAULT_PALETTE,
  colors: themeColors,
};

const speculation = { prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] };

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.shortName,
  jobTitle: profile.headline,
  url: site.href,
  image: ogImage,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Instituto Federal do Piauí' },
  worksFor: { '@type': 'Organization', name: 'Investe Piauí' },
  sameAs: [links.github.href, links.instagram.href, links.lattes.href, links.orcid.href],
};
---

<!doctype html>
<html lang="pt-BR" data-palette={DEFAULT_PALETTE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={defaultPalette.light.canvas} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={defaultPalette.dark.canvas} media="(prefers-color-scheme: dark)" />

    <script is:inline define:vars={{ boot }}>
      // Aplica paleta, modo e preferência de movimento antes de pintar a página.
      var root = document.documentElement;
      // Avisa o CSS que há script: é o que libera o cabeçalho transparente da página inicial.
      // O mesmo script marca o cabeçalho quando a página rola (classe is-scrolled), para que
      // o cabeçalho transparente nunca dependa do módulo de interações, que carrega depois.
      root.classList.add('js');
      var header = null;
      var syncHeader = function () {
        header = header || document.querySelector('[data-header]');
        if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      window.addEventListener('scroll', syncHeader, { passive: true });
      document.addEventListener('DOMContentLoaded', syncHeader);
      window.addEventListener('pageshow', syncHeader);
      var read = function (key) {
        try {
          return localStorage.getItem(key);
        } catch (e) {
          return null;
        }
      };
      var prefers = function (query) {
        return !!(window.matchMedia && window.matchMedia(query).matches);
      };
      var palette = read('cm-palette');
      root.dataset.palette = boot.ids.indexOf(palette) > -1 ? palette : boot.fallback;
      var mode = read('cm-mode');
      root.dataset.mode = mode === 'light' || mode === 'dark' ? mode : prefers('(prefers-color-scheme: dark)') ? 'dark' : 'light';
      var motion = read('cm-motion');
      root.dataset.motion = motion === 'reduce' || motion === 'full' ? motion : prefers('(prefers-reduced-motion: reduce)') ? 'reduce' : 'full';
      var color = boot.colors[root.dataset.palette][root.dataset.mode];
      document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
        meta.setAttribute('content', color);
        meta.removeAttribute('media');
      });
      window.__themeColors = boot.colors;
    </script>
    <style is:inline set:html={themeCss}></style>

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
    <!-- fontes que só uma página usa (as do design system de um projeto, por exemplo) -->
    <slot name="head" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={profile.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Retrato de ${profile.shortName} com o nome completo, a área de atuação e o endereço do site`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <!-- pré-carrega a página do link quando o ponteiro para sobre ele: navegação e transição instantâneas -->
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header current={current} overlay={overlayHeader} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
