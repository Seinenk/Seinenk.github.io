---
import Icon from '../Icon.astro';
import type { Swatch } from '../../data/projects/types';

/*
 * Paleta do projeto: cada amostra é um botão que copia o hex. O texto sobre a cor
 * é claro ou escuro conforme a luminância, para manter a leitura em qualquer cor.
 */
interface Props {
  swatches: Swatch[];
  gradient?: string[];
  note?: string;
}

const { swatches, gradient, note } = Astro.props;

const luminance = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
// texto branco ou preto, o que der mais contraste: com os dois extremos, toda cor
// tem pelo menos 4,58:1 com um deles
const onColor = (hex: string) => {
  const l = luminance(hex);
  return 1.05 / (l + 0.05) >= (l + 0.05) / 0.05 ? '#FFFFFF' : '#000000';
};
---

<div class="palette">
  <ul class="list-reset swatches" role="list">
    {
      swatches.map((s, i) => (
        <li class="swatch" data-reveal="scale" style={`--i:${i % 6};--sw:${s.hex};--on:${onColor(s.hex)}`}>
          <button class="swatch-color" type="button" data-copy={s.hex} aria-label={`Copiar ${s.hex} (${s.name})`}>
            <span class="swatch-hex">{s.hex}</span>
            <span class="swatch-copy" aria-hidden="true">
              <Icon name="copy" size={15} />
              <span data-copy-label>Copiar</span>
            </span>
          </button>
          <p class="swatch-name">{s.name}</p>
          <p class="swatch-role">{s.role}</p>
        </li>
      ))
    }
  </ul>
  {
    gradient && (
      <div class="gradient" data-reveal style={`--g:linear-gradient(110deg, ${gradient.join(', ')})`}>
        <span class="gradient-label">Degradê da marca</span>
        <span class="gradient-stops">{gradient.join(' → ')}</span>
      </div>
    )
  }
  {note && <p class="palette-note" data-reveal>{note}</p>}
  <p class="sr-only" aria-live="polite" data-copy-status></p>
</div>

<style>
  .swatches {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr));
  }

  .swatch-color {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    aspect-ratio: 1 / 1.08;
    padding: 0.8rem;
    border: 1px solid rgb(var(--c-shadow-rgb) / 0.12);
    border-radius: var(--radius-lg);
    background: var(--sw);
    color: var(--on);
    text-align: start;
    cursor: copy;
    transition:
      transform 0.5s var(--ease-spring),
      box-shadow 0.5s var(--ease-out);
  }

  .swatch-color:hover,
  .swatch-color:focus-visible {
    transform: translateY(-6px) rotate(-1.5deg);
    box-shadow: var(--shadow-md);
  }

  .swatch-hex {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
  }

  .swatch-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-end;
    font-size: var(--fs-caption);
    font-weight: 600;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--ease-out);
  }

  .swatch-color:hover .swatch-copy,
  .swatch-color:focus-visible .swatch-copy,
  .swatch-color.is-copied .swatch-copy {
    opacity: 1;
    transform: none;
  }

  .swatch-name {
    margin-top: 0.6rem;
    color: var(--c-ink);
    font-weight: 600;
  }

  .swatch-role {
    color: var(--c-muted);
    font-size: var(--fs-caption);
    line-height: 1.4;
  }

  .gradient {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 7rem;
    margin-top: 1.25rem;
    padding: 1rem 1.2rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--g);
    color: #fff;
  }

  .gradient::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.22) 50%, transparent 70%);
    transform: translateX(-100%);
  }

  :global(:root[data-motion='full']) .gradient::after {
    animation: sheen 5s var(--ease-in-out) infinite;
  }

  @keyframes sheen {
    0%,
    40% {
      transform: translateX(-100%);
    }
    80%,
    100% {
      transform: translateX(100%);
    }
  }

  .gradient-label {
    font-weight: 600;
  }

  .gradient-stops {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    opacity: 0.9;
  }

  .palette-note {
    margin-top: 1rem;
    color: var(--c-muted);
    font-size: var(--fs-body-sm);
  }
</style>
