---
/*
 * Emblema do Crohnease redesenhado em SVG a partir do logo do redesenho (v2): o anel
 * verde-água, o disco claro e a linha de batimento turquesa no meio. Sem o nome: o
 * logotipo completo aparece na galeria. Com movimento ligado, o anel bate devagar e a
 * linha se desenha de novo a cada batida.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['crm', className]} viewBox="0 0 120 120" aria-hidden="true" focusable="false">
  <g class="crm-beat">
    <circle class="crm-ring" cx="60" cy="60" r="51" />
    <circle class="crm-disc" cx="60" cy="60" r="39" />
  </g>
  <path class="crm-pulse" d="M27 61H40L46 52L52 39L60 77L67 51L72 60H93" pathLength="100" />
</svg>

<style>
  .crm {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .crm-ring {
    fill: none;
    stroke: #4fd1c5;
    stroke-width: 9;
  }

  .crm-disc {
    fill: #f5f5f5;
  }

  .crm-pulse {
    fill: none;
    stroke: #00bbc9;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
  }

  .crm-beat {
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(:root[data-motion='full']) .crm-beat {
    animation: crm-beat 3.2s ease-in-out infinite;
  }

  :global(:root[data-motion='full']) .crm-pulse {
    animation: crm-draw 3.2s ease-in-out infinite;
  }

  /* duas batidas curtas, como um coração, e uma pausa */
  @keyframes crm-beat {
    0%,
    30%,
    100% {
      scale: 1;
    }
    8% {
      scale: 1.05;
    }
    16% {
      scale: 0.99;
    }
    22% {
      scale: 1.03;
    }
  }

  @keyframes crm-draw {
    0% {
      stroke-dashoffset: 100;
    }
    35%,
    85% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -100;
    }
  }
</style>
