---
import { Image } from 'astro:assets';
import type { Compare } from '../../data/projects/types';

/*
 * Comparação "antes e depois" com um controle deslizante de verdade (input range):
 * funciona com mouse, toque e teclado (setas), e o valor é anunciado. Com
 * frame="phone", o palco vira um celular estreito, para prints de app.
 */
interface Props {
  compare: Compare;
}

const { before, after, frame, caption } = Astro.props.compare;
const phone = frame === 'phone';
const ratio = `${after.src.width} / ${after.src.height}`;
const sizes = phone ? '(min-width: 40rem) 22rem, 82vw' : '(min-width: 64rem) 52rem, 92vw';
const widthsFor = (w: number) => (phone ? [Math.min(w, 360), w] : [Math.min(w, 640), w]).filter((v, i, a) => a.indexOf(v) === i);
---

<figure
  class:list={['ba', { 'ba-phone': phone }]}
  data-before-after
  data-only-after={`Só ${after.name}`}
  data-only-before={`Só ${before.name}`}
  data-partial={`{n}% mostrando ${before.name}, à esquerda`}
  style="--pos:50%"
>
  <div class="ba-stage" style={`aspect-ratio:${ratio}`}>
    <Image src={after.src} alt={after.alt} widths={widthsFor(after.src.width)} sizes={sizes} class="ba-img" />
    <div class="ba-before">
      <Image src={before.src} alt={before.alt} widths={widthsFor(before.src.width)} sizes={sizes} class="ba-img" />
    </div>
    <span class="ba-tag ba-tag-before" aria-hidden="true">{before.tag}</span>
    <span class="ba-tag ba-tag-after" aria-hidden="true">{after.tag}</span>
    <span class="ba-handle" aria-hidden="true">
      <span class="ba-knob">‹ ›</span>
    </span>
    <input class="ba-range" type="range" min="0" max="100" value="50" step="1" aria-label={`Comparar ${before.name} com ${after.name}`} aria-valuetext="Metade de cada versão" data-ba-range />
  </div>
  <figcaption class="ba-caption">{caption}</figcaption>
</figure>

<style>
  .ba {
    margin: 0;
  }

  .ba-stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    background: var(--c-surface-card);
  }

  /* prints de celular: um aparelho estreito no centro, com moldura escura */
  .ba-phone .ba-stage {
    width: min(100%, 22rem);
    margin-inline: auto;
    border: 0.55rem solid #0b0a12;
    border-radius: 2.4rem;
    background: #0b0a12;
    box-shadow:
      0 0 0 1px var(--c-hairline),
      var(--shadow-lg);
  }

  .ba-phone .ba-stage :global(.ba-img) {
    object-position: top center;
  }

  .ba-phone .ba-tag {
    top: 1.1rem;
  }

  .ba-phone .ba-caption {
    max-width: 34rem;
    margin-inline: auto;
    text-align: center;
  }

  .ba-stage :global(.ba-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    translate: -50% 0;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
    pointer-events: none;
  }

  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    color: #181722;
    font-weight: 700;
    letter-spacing: 0.1em;
    box-shadow: var(--shadow-md);
    transition: scale 0.3s var(--ease-spring);
  }

  .ba-stage:has(.ba-range:focus-visible) .ba-knob {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  .ba-stage:hover .ba-knob {
    scale: 1.08;
  }

  .ba-tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgb(24 23 34 / 0.78);
    color: #fff;
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    pointer-events: none;
  }

  .ba-tag-before {
    left: 0.75rem;
  }

  .ba-tag-after {
    right: 0.75rem;
  }

  /* o input cobre o palco: arrastar em qualquer ponto move a divisória */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .ba-caption {
    margin-top: 0.8rem;
    color: var(--c-muted);
    font-size: var(--fs-caption);
  }

  /* dica de movimento na primeira vez que aparece */
  :global(:root[data-motion='full']) .ba.is-hinting .ba-before,
  :global(:root[data-motion='full']) .ba.is-hinting .ba-handle {
    transition:
      clip-path 1.1s var(--ease-in-out),
      left 1.1s var(--ease-in-out);
  }
</style>
