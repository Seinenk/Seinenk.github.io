---
/*
 * Emblema do EFIPLA redesenhado em SVG a partir do ícone do app: o d20 sobre um
 * escudo, preso por uma faixa, no centro de um círculo mágico com runas. Sem o nome:
 * o logotipo em Rubik Distressed fica no ícone de verdade, na galeria.
 * Com movimento ligado, o anel de runas gira, o dado rola de tempos em tempos e
 * sempre para no 20, o acerto crítico.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);

/* runas desenhadas a traço, numa caixa de 5 × 10 (inspiradas no futhark antigo) */
const runes = [
  'M0 0V10M0 2L5 0M0 5L5 3',
  'M0 10V0L5 3V10',
  'M0 0V10M0 3L4 5L0 7',
  'M0 0V10M0 0L5 3M0 4L5 7',
  'M0 10V0L4 2.5L0 5L5 10',
  'M5 0L0 5L5 10',
  'M0 0L5 10M5 0L0 10',
  'M2.5 10V0M2.5 4L0 0M2.5 4L5 0',
  'M2.5 10V0M0 3L2.5 0L5 3',
  'M0 0V10M0 0L4 2.5L0 5L4 7.5L0 10',
  'M0 10V0L5 4M5 10V0L0 4',
];
const ring = Array.from({ length: 26 }, (_, i) => ({ rune: i % runes.length, angle: (360 / 26) * i }));
const ribbonRunes = [80, 88, 96, 104, 112, 120];

/* o d20 visto de frente: hexágono, triângulo central e as faces em volta */
const cx = 100;
const cy = 101;
const R = 27;
const r = 14;
const hx = R * Math.cos(Math.PI / 6);
const H = [
  [cx, cy - R],
  [cx + hx, cy - R / 2],
  [cx + hx, cy + R / 2],
  [cx, cy + R],
  [cx - hx, cy + R / 2],
  [cx - hx, cy - R / 2],
];
const tx = r * Math.cos(Math.PI / 6);
const A = [cx, cy - r];
const B = [cx - tx, cy + r / 2];
const C = [cx + tx, cy + r / 2];
const pts = (...ps: number[][]) => ps.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' ');
// luz vindo do alto à esquerda: faces de cima mais claras, de baixo à direita mais escuras
const faces = [
  { p: pts(A, H[5], H[0]), fill: '#E2D8FF' },
  { p: pts(A, H[0], H[1]), fill: '#CFBDFE' },
  { p: pts(A, B, H[5]), fill: '#D8CCFF' },
  { p: pts(B, H[4], H[5]), fill: '#B9A7EC' },
  { p: pts(A, C, H[1]), fill: '#BFADF2' },
  { p: pts(C, H[2], H[1]), fill: '#A08CD8' },
  { p: pts(B, C, H[3]), fill: '#C9BAF6' },
  { p: pts(B, H[3], H[4]), fill: '#A996DE' },
  { p: pts(C, H[2], H[3]), fill: '#8F7BC9' },
  { p: pts(A, B, C), fill: '#F3EEFF' },
];
const sparks = [
  { x: 50, y: 56, s: 1, d: 0 },
  { x: 152, y: 50, s: 0.8, d: 1.1 },
  { x: 158, y: 146, s: 0.9, d: 2.3 },
  { x: 44, y: 142, s: 0.7, d: 0.6 },
];
---

<svg class:list={['ef-mark', className]} viewBox="0 0 200 200" aria-hidden="true">
  <defs>
    <radialGradient id={`efg-${uid}`}>
      <stop offset="0" stop-color="#CFBDFE" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#CFBDFE" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id={`efc-${uid}`}>
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.85"></stop>
      <stop offset="0.45" stop-color="#E9DDFF" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#CFBDFE" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`efs-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4D3D75"></stop>
      <stop offset="0.55" stop-color="#2A2440"></stop>
      <stop offset="1" stop-color="#1D192E"></stop>
    </linearGradient>
    <linearGradient id={`efr-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E9DDFF"></stop>
      <stop offset="1" stop-color="#B9A7EC"></stop>
    </linearGradient>
    {runes.map((d, i) => <path id={`efu-${uid}-${i}`} d={d} />)}
  </defs>

  <circle class="ef-aura" cx="100" cy="100" r="98" fill={`url(#efg-${uid})`}></circle>

  <g class="ef-ring">
    <circle cx="100" cy="100" r="94" class="ef-line"></circle>
    <circle cx="100" cy="100" r="79" class="ef-line ef-line-soft"></circle>
    {ring.map((u) => <use href={`#efu-${uid}-${u.rune}`} class="ef-rune" transform={`rotate(${u.angle.toFixed(2)} 100 100) translate(97.5 9)`} />)}
  </g>

  <g class="ef-star">
    <polygon points="100,26 164.1,137 35.9,137" class="ef-line ef-line-faint"></polygon>
    <polygon points="100,174 35.9,63 164.1,63" class="ef-line ef-line-faint"></polygon>
  </g>

  <path class="ef-shield" d="M100 50L142 63V103C142 133 123 151 100 162C77 151 58 133 58 103V63Z" fill={`url(#efs-${uid})`}></path>
  <path class="ef-shield-in" d="M100 57L135 68V103C135 128 119 144 100 154C81 144 65 128 65 103V68Z"></path>

  <circle class="ef-core" cx={cx} cy={cy} r="34" fill={`url(#efc-${uid})`}></circle>
  <circle class="ef-burst" cx={cx} cy={cy} r="30"></circle>

  <g class="ef-die">
    {faces.map((f) => <polygon points={f.p} fill={f.fill} class="ef-face" />)}
    <text class="ef-num ef-n20" x={cx} y={cy + 3.4} text-anchor="middle">20</text>
    <text class="ef-num ef-n7" x={cx} y={cy + 3.4} text-anchor="middle">7</text>
    <text class="ef-num ef-n13" x={cx} y={cy + 3.4} text-anchor="middle">13</text>
    <text class="ef-num ef-n4" x={cx} y={cy + 3.4} text-anchor="middle">4</text>
  </g>

  <g class="ef-ribbon">
    <path d="M62 129L47 131L53 136.5L47 143L63 140Z" class="ef-tail"></path>
    <path d="M138 129L153 131L147 136.5L153 143L137 140Z" class="ef-tail"></path>
    <path d="M60 126Q100 136 140 126L138 138Q100 148 62 138Z" fill={`url(#efr-${uid})`} class="ef-band"></path>
    {ribbonRunes.map((x, i) => <use href={`#efu-${uid}-${(i * 3) % runes.length}`} class="ef-ribbon-rune" transform={`translate(${x - 1.25} ${(134.5 - (x - 100) * (x - 100) * 0.0031).toFixed(2)}) scale(0.5)`} />)}
  </g>

  {
    sparks.map((s) => (
      <g transform={`translate(${s.x} ${s.y}) scale(${s.s})`}>
        <path class="ef-spark" style={`--d:${s.d}s`} d="M0 -7C0.9 -1.6 1.6 -0.9 7 0C1.6 0.9 0.9 1.6 0 7C-0.9 1.6 -1.6 0.9 -7 0C-1.6 -0.9 -0.9 -1.6 0 -7Z" />
      </g>
    ))
  }
</svg>

<style>
  .ef-mark {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ef-line {
    fill: none;
    stroke: #cfbdfe;
    stroke-width: 1.2;
    stroke-opacity: 0.6;
  }

  .ef-line-soft {
    stroke-opacity: 0.4;
  }

  .ef-line-faint {
    stroke-opacity: 0.22;
    stroke-linejoin: round;
  }

  .ef-rune {
    fill: none;
    stroke: #cfbdfe;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-opacity: 0.8;
  }

  .ef-shield {
    stroke: #cfbdfe;
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .ef-shield-in {
    fill: none;
    stroke: #cfbdfe;
    stroke-width: 1.2;
    stroke-opacity: 0.35;
  }

  .ef-face {
    stroke: #241e38;
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .ef-num {
    fill: #241e38;
    font:
      800 9px var(--font-sans),
      system-ui,
      sans-serif;
  }

  .ef-n7,
  .ef-n13,
  .ef-n4 {
    opacity: 0;
  }

  .ef-burst {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .ef-tail {
    fill: #a996de;
    stroke: #241e38;
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  .ef-band {
    stroke: #241e38;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .ef-ribbon-rune {
    fill: none;
    stroke: #241e38;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ef-spark {
    fill: #f3eeff;
  }

  .ef-ring,
  .ef-star,
  .ef-die,
  .ef-core,
  .ef-spark {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ---------- movimento ---------- */
  :global(:root[data-motion='full']) .ef-ring {
    animation: ef-spin 80s linear infinite;
  }

  :global(:root[data-motion='full']) .ef-star {
    animation: ef-spin 140s linear infinite reverse;
  }

  :global(:root[data-motion='full']) .ef-die {
    animation: ef-roll 7s var(--ease-in-out) infinite;
  }

  :global(:root[data-motion='full']) .ef-n20 {
    animation: ef-n20 7s step-end infinite;
  }

  :global(:root[data-motion='full']) .ef-n7 {
    animation: ef-n7 7s step-end infinite;
  }

  :global(:root[data-motion='full']) .ef-n13 {
    animation: ef-n13 7s step-end infinite;
  }

  :global(:root[data-motion='full']) .ef-n4 {
    animation: ef-n4 7s step-end infinite;
  }

  :global(:root[data-motion='full']) .ef-burst {
    animation: ef-burst 7s var(--ease-out) infinite;
  }

  :global(:root[data-motion='full']) .ef-core {
    animation: ef-core 7s var(--ease-in-out) infinite;
  }

  :global(:root[data-motion='full']) .ef-spark {
    animation: ef-twinkle 2.6s ease-in-out var(--d) infinite alternate;
  }

  @keyframes ef-spin {
    to {
      rotate: 360deg;
    }
  }

  /* parado, flutua; depois gira, quica e para de novo no 20 */
  @keyframes ef-roll {
    0%,
    60% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
    30% {
      transform: translateY(-2px) rotate(0deg) scale(1);
    }
    65% {
      transform: translateY(-6px) rotate(-20deg) scale(0.92);
    }
    73% {
      transform: translateY(-2px) rotate(170deg) scale(1.08);
    }
    80% {
      transform: translateY(0) rotate(320deg) scale(1.02);
    }
    86%,
    100% {
      transform: translateY(0) rotate(360deg) scale(1);
    }
  }

  @keyframes ef-n20 {
    0% {
      opacity: 1;
    }
    64% {
      opacity: 0;
    }
    84% {
      opacity: 1;
    }
  }

  @keyframes ef-n7 {
    0% {
      opacity: 0;
    }
    64% {
      opacity: 1;
    }
    70% {
      opacity: 0;
    }
  }

  @keyframes ef-n13 {
    0% {
      opacity: 0;
    }
    70% {
      opacity: 1;
    }
    77% {
      opacity: 0;
    }
  }

  @keyframes ef-n4 {
    0% {
      opacity: 0;
    }
    77% {
      opacity: 1;
    }
    84% {
      opacity: 0;
    }
  }

  @keyframes ef-burst {
    0%,
    84% {
      opacity: 0;
      transform: scale(1);
    }
    86% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  @keyframes ef-core {
    0%,
    80%,
    100% {
      opacity: 0.85;
      transform: scale(1);
    }
    88% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  @keyframes ef-twinkle {
    from {
      opacity: 0.2;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1.1);
    }
  }
</style>
