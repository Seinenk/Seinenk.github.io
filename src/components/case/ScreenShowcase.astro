---
import { Image } from 'astro:assets';
import type { Shot } from '../../data/projects/types';

/*
 * Vitrine das telas, no alto do bloco "Telas" de cada projeto: um leque de celulares
 * (como em "Main Screens") ou janelas de navegador sobrepostas (como em "Main Pages"),
 * com um caminho tracejado e etiquetas que flutuam por cima. É só decoração: as mesmas
 * telas aparecem logo abaixo, na galeria, com texto alternativo e legenda.
 */
interface Props {
  shots: Shot[];
  /** Etiquetas curtas que flutuam sobre o caminho tracejado (as tags do projeto). */
  labels?: string[];
}

const { shots, labels = [] } = Astro.props;
const phones = shots.filter((s) => s.frame === 'phone');
const browsers = shots.filter((s) => s.frame === 'browser');
const mode = phones.length >= 3 ? 'phones' : browsers.length >= 2 ? 'browsers' : null;

// Leque de celulares: o primeiro no centro, os seguintes alternando dos lados.
const order = [3, 1, 0, 2, 4];
const fan = mode === 'phones' ? order.filter((i) => i < Math.min(phones.length, 5)).map((i) => ({ shot: phones[i], slot: i })) : [];

// Janelas: duas atrás, inclinadas, e uma na frente.
const windows = mode === 'browsers' ? browsers.slice(0, 3) : [];
const sidePhone = mode === 'browsers' ? phones[0] : undefined;

const pills = labels.slice(0, 3);
---

{
  mode && (
    <div class:list={['sc', `sc-${mode}`]} aria-hidden="true" data-reveal="fade" data-ambient>
      <svg class="sc-path" viewBox="0 0 160 90" preserveAspectRatio="none" focusable="false">
        <path d="M-4 70 C 22 40, 40 92, 70 66 S 118 12, 164 30" />
      </svg>

      {mode === 'phones' && (
        <div class="sc-stage">
          {fan.map(({ shot, slot }) => (
            <figure class={`sc-phone sc-slot-${slot}`} style={`--slot:${slot}`}>
              <span class="sc-island" />
              <Image
                src={shot.src}
                alt=""
                widths={[220, 320, 440]}
                sizes="(min-width: 64rem) 12rem, 30vw"
                quality={72}
                class="sc-img"
              />
            </figure>
          ))}
        </div>
      )}

      {mode === 'browsers' && (
        <div class="sc-stage">
          {windows.map((shot, i) => (
            <figure class={`sc-window sc-win-${i}`} style={`--slot:${i}`}>
              <span class="sc-bar">
                <i />
                <i />
                <i />
                <span class="sc-url" />
              </span>
              <Image
                src={shot.src}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 64rem) 34rem, 70vw"
                quality={72}
                class="sc-img"
              />
            </figure>
          ))}
          {sidePhone && (
            <figure class="sc-phone sc-phone-side" style="--slot:3">
              <span class="sc-island" />
              <Image src={sidePhone.src} alt="" widths={[200, 300]} sizes="9rem" quality={72} class="sc-img" />
            </figure>
          )}
        </div>
      )}

      {pills.map((label, i) => (
        <span class={`sc-pill sc-pill-${i}`} style={`--p:${i}`}>
          {label}
        </span>
      ))}
    </div>
  )
}

<style>
  .sc {
    position: relative;
    isolation: isolate;
    margin-block: 0.5rem 2rem;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(60% 70% at 50% 40%, rgb(var(--c-cyan-rgb) / 0.1), transparent 70%),
      radial-gradient(45% 55% at 85% 80%, rgb(var(--c-violet-rgb) / 0.1), transparent 70%),
      linear-gradient(180deg, var(--c-surface-soft), var(--c-surface-card));
    border: 1px solid var(--c-hairline-soft);
    overflow: hidden;
    perspective: 1600px;
  }

  @media (max-width: 40rem) {
    .sc {
      aspect-ratio: 4 / 3.4;
    }
  }

  /* ---------- caminho tracejado ---------- */
  .sc-path {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    fill: none;
    stroke: var(--c-cyan);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
  }

  :global(:root[data-motion='full']) .sc-path {
    animation: sc-dash 22s linear infinite;
  }

  @keyframes sc-dash {
    to {
      stroke-dashoffset: -140;
    }
  }

  .sc-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    transform-style: preserve-3d;
  }

  .sc-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* ---------- celulares ---------- */
  .sc-phone {
    --w: 21%;
    --x: 39.5%;
    --y: 9%;
    --r: 0deg;
    --z: 0px;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: 9 / 19.5;
    margin: 0;
    padding: 2.2%;
    border-radius: 14% / 6.5%;
    background: #0d0d12;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      0 1.5rem 3rem -1.25rem rgb(var(--c-shadow-rgb) / 0.55);
    transform: translateZ(var(--z)) rotate(var(--r));
    transition:
      transform 0.9s var(--ease-out),
      opacity 0.9s var(--ease-out);
  }

  .sc-phone .sc-img {
    border-radius: 11% / 5%;
    background: var(--c-surface-card);
  }

  .sc-island {
    position: absolute;
    top: 3.6%;
    left: 50%;
    z-index: 2;
    width: 28%;
    height: 2.4%;
    border-radius: 999px;
    background: #0d0d12;
    translate: -50% 0;
  }

  .sc-slot-0 {
    --w: 21%;
    --x: 39.5%;
    --y: 7%;
    --z: 40px;
    z-index: 3;
  }

  .sc-slot-1 {
    --w: 18%;
    --x: 22%;
    --y: 15%;
    --r: -7deg;
    z-index: 2;
  }

  .sc-slot-2 {
    --w: 18%;
    --x: 60%;
    --y: 15%;
    --r: 7deg;
    z-index: 2;
  }

  .sc-slot-3 {
    --w: 15%;
    --x: 6.5%;
    --y: 26%;
    --r: -13deg;
    --z: -40px;
    z-index: 1;
  }

  .sc-slot-4 {
    --w: 15%;
    --x: 78.5%;
    --y: 26%;
    --r: 13deg;
    --z: -40px;
    z-index: 1;
  }

  /* no celular, só os três do meio, maiores */
  @media (max-width: 40rem) {
    .sc-slot-3,
    .sc-slot-4 {
      display: none;
    }

    .sc-slot-0 {
      --w: 30%;
      --x: 35%;
    }

    .sc-slot-1 {
      --w: 26%;
      --x: 9%;
      --y: 16%;
    }

    .sc-slot-2 {
      --w: 26%;
      --x: 65%;
      --y: 16%;
    }
  }

  /* entrada: os celulares saem do centro e se abrem em leque (--from é a distância até o meio) */
  .sc-slot-1 {
    --from: 95%;
  }

  .sc-slot-2 {
    --from: -95%;
  }

  .sc-slot-3 {
    --from: 230%;
  }

  .sc-slot-4 {
    --from: -230%;
  }

  :global(:root[data-motion='full'].reveal-ready) .sc:not(:global(.is-visible)) .sc-phone {
    opacity: 0;
    transform: translateX(var(--from, 0%)) translateY(10%) rotate(0deg);
  }

  :global(:root[data-motion='full']) .sc:global(.is-visible) .sc-phone {
    transition-delay: calc(var(--slot) * 90ms + 150ms);
  }

  /* depois de aberto, cada um flutua no seu ritmo */
  :global(:root[data-motion='full']) .sc:global(.is-visible) .sc-phone .sc-img {
    animation: sc-glow 7s ease-in-out infinite;
    animation-delay: calc(var(--slot) * -1.3s);
  }

  @keyframes sc-glow {
    0%,
    100% {
      filter: none;
    }
    50% {
      filter: brightness(1.04) saturate(1.05);
    }
  }

  :global(:root[data-motion='full']) .sc:global(.is-visible) .sc-stage {
    animation: sc-float 9s ease-in-out infinite;
  }

  @keyframes sc-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-1.2%);
    }
  }

  /* ao passar o ponteiro, o leque se endireita e se aproxima */
  @media (hover: hover) and (pointer: fine) {
    .sc:hover .sc-phone {
      transform: translateZ(var(--z)) rotate(calc(var(--r) * 0.35)) translateY(-3%);
    }

    .sc:hover .sc-slot-0 {
      transform: translateZ(70px) translateY(-4%);
    }
  }

  /* ---------- janelas de navegador ---------- */
  .sc-window {
    --w: 46%;
    position: absolute;
    width: var(--w);
    aspect-ratio: 16 / 10.6;
    margin: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    border-radius: 10px;
    background: var(--c-surface-raised);
    box-shadow:
      0 0 0 1px var(--c-hairline),
      0 1.75rem 3.5rem -1.5rem rgb(var(--c-shadow-rgb) / 0.55);
    transition:
      transform 1s var(--ease-out),
      opacity 1s var(--ease-out);
  }

  .sc-bar {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--c-hairline-soft);
    background: var(--c-surface-soft);
  }

  .sc-bar i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--c-hairline);
  }

  .sc-bar i:first-child {
    background: rgb(var(--c-cyan-rgb) / 0.6);
  }

  .sc-bar i:nth-child(2) {
    background: rgb(var(--c-violet-rgb) / 0.55);
  }

  .sc-url {
    flex: 1;
    max-width: 45%;
    height: 0.55rem;
    margin-inline: auto;
    border-radius: 999px;
    background: var(--c-surface-card);
  }

  .sc-win-0 {
    left: 3%;
    top: 7%;
    transform: rotateY(16deg) translateZ(-60px);
    z-index: 1;
  }

  .sc-win-1 {
    right: 3%;
    top: 7%;
    transform: rotateY(-16deg) translateZ(-60px);
    z-index: 1;
  }

  .sc-win-2 {
    --w: 60%;
    left: 20%;
    top: 30%;
    transform: translateZ(30px);
    z-index: 2;
  }

  .sc-phone-side {
    --w: 13%;
    --x: 80%;
    --y: 38%;
    --r: 6deg;
    --z: 60px;
    z-index: 3;
  }

  @media (max-width: 40rem) {
    .sc-win-0,
    .sc-win-1 {
      --w: 58%;
    }

    .sc-win-2 {
      --w: 76%;
      left: 12%;
      top: 34%;
    }

    .sc-phone-side {
      --w: 18%;
      --x: 78%;
      --y: 46%;
    }
  }

  :global(:root[data-motion='full'].reveal-ready) .sc:not(:global(.is-visible)) .sc-window {
    opacity: 0;
    transform: translateY(14%) rotateX(12deg);
  }

  :global(:root[data-motion='full']) .sc:global(.is-visible) .sc-window {
    transition-delay: calc(var(--slot) * 120ms + 150ms);
  }

  @media (hover: hover) and (pointer: fine) {
    .sc-browsers:hover .sc-win-0 {
      transform: rotateY(8deg) translateZ(-30px) translateX(-3%);
    }

    .sc-browsers:hover .sc-win-1 {
      transform: rotateY(-8deg) translateZ(-30px) translateX(3%);
    }

    .sc-browsers:hover .sc-win-2 {
      transform: translateZ(60px) translateY(-2%);
    }
  }

  /* ---------- etiquetas sobre o caminho ---------- */
  .sc-pill {
    position: absolute;
    z-index: 4;
    padding: 0.4rem 0.95rem;
    border: 1px solid rgb(var(--c-cyan-rgb) / 0.45);
    border-radius: 999px;
    background: rgb(var(--c-canvas-rgb) / 0.86);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--c-cyan-strong);
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.2rem);
    font-style: italic;
    white-space: nowrap;
    box-shadow: 0 0.6rem 1.4rem -0.9rem rgb(var(--c-shadow-rgb) / 0.5);
    rotate: var(--pr, 0deg);
  }

  .sc-pill-0 {
    left: 3%;
    bottom: 9%;
    --pr: -4deg;
  }

  .sc-pill-1 {
    left: 44%;
    bottom: 4%;
    --pr: 3deg;
    border-color: rgb(var(--c-violet-rgb) / 0.45);
    color: var(--c-violet-strong);
  }

  .sc-pill-2 {
    right: 3%;
    top: 6%;
    --pr: -6deg;
  }

  @media (max-width: 40rem) {
    .sc-pill-1 {
      display: none;
    }
  }

  :global(:root[data-motion='full']) .sc:global(.is-visible) .sc-pill {
    animation: float 6s ease-in-out infinite;
    animation-delay: calc(var(--p) * -2s);
  }
</style>
