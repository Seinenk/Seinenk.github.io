---
/*
 * O exercício Layout Simples refeito ao vivo, com as mesmas cores e medidas do
 * CSS original (em escala). O interruptor mostra as caixas do flexbox; é só CSS.
 */
---

<div class="lb">
  <label class="lb-switch">
    <input type="checkbox" class="lb-input" />
    <span class="lb-track" aria-hidden="true"><span></span></span>
    Mostrar as caixas
  </label>
  <div class="lb-page">
    <header class="lb-head lb-box" data-box="header · display: flex">
      <span class="lb-logo">Logo</span>
      <nav class="lb-menu lb-box" data-box="ul · flex">
        <span>Home</span>
        <span>| Cursos</span>
        <span>| Professores</span>
        <span>| Contato</span>
      </nav>
    </header>
    <div class="lb-cards lb-box" data-box="div.container · flex · space-around">
      <div class="lb-card lb-1 lb-box" data-box="200 × 200">Missão</div>
      <div class="lb-card lb-2 lb-box" data-box="200 × 200">Visão</div>
      <div class="lb-card lb-3 lb-box" data-box="200 × 200">Valores</div>
    </div>
    <footer class="lb-foot lb-box" data-box="footer · position: fixed">@carlosmichaels_</footer>
  </div>
</div>

<style>
  .lb {
    display: grid;
    gap: 1rem;
  }

  .lb-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    color: var(--c-ink);
    font-weight: 500;
    cursor: pointer;
  }

  .lb-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .lb-track {
    position: relative;
    width: 2.6rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--c-surface-strong);
    border: 1px solid var(--c-outline);
    transition: background-color 0.3s ease;
  }

  .lb-track span {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 1.05rem;
    height: 1.05rem;
    translate: 0 -50%;
    border-radius: 50%;
    background: var(--c-canvas);
    box-shadow: var(--shadow-sm);
    transition: left 0.35s var(--ease-spring);
  }

  .lb-input:checked + .lb-track {
    background: var(--c-primary);
  }

  .lb-input:checked + .lb-track span {
    left: calc(100% - 1.25rem);
  }

  .lb-input:focus-visible + .lb-track {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }

  .lb-page {
    container-type: inline-size;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 22rem;
    overflow: hidden;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-xl);
    background: #fff;
    color: #000;
    font-family: 'Times New Roman', Times, serif;
    box-shadow: var(--shadow-md);
  }

  .lb-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 0.5rem 0.75rem;
    background: #8e7cc3;
  }

  .lb-logo {
    padding: 0.4rem 1rem;
    border: 1px solid #000;
    border-radius: 5px;
    background: #eee;
    font-size: 1.15rem;
    font-weight: 700;
  }

  /* 20 px como no CSS original, em negrito para o branco sobre o lilás ter contraste de texto grande */
  .lb-menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    color: #fff;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .lb-cards {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 0.5rem;
    padding: 1.5rem 0.75rem;
  }

  .lb-card {
    display: grid;
    justify-items: center;
    width: min(9rem, 26cqw);
    aspect-ratio: 1;
    padding-top: 0.9rem;
    border-radius: 0.9rem;
    font-size: clamp(0.9rem, 2.6cqw, 1.2rem);
  }

  .lb-1 {
    background: #6aa84f;
  }

  .lb-2 {
    background: #6fa8dc;
  }

  .lb-3 {
    background: #f6b26b;
  }

  .lb-foot {
    display: grid;
    place-items: center;
    min-height: 3.5rem;
    background: #999;
    font-size: 1.1rem;
  }

  /* caixas à mostra */
  .lb-box {
    position: relative;
    outline: 2px dashed transparent;
    outline-offset: -2px;
    transition: outline-color 0.3s ease;
  }

  .lb-box::after {
    content: attr(data-box);
    position: absolute;
    top: 0.2rem;
    right: 0.2rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: #181722;
    color: #fff;
    font: 500 0.68rem / 1.3 var(--font-mono);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.3s ease,
      transform 0.35s var(--ease-out);
    pointer-events: none;
  }

  .lb:has(.lb-input:checked) .lb-box {
    outline-color: #e5175d;
  }

  .lb:has(.lb-input:checked) .lb-box::after {
    opacity: 1;
    transform: none;
  }

  .lb-card.lb-box::after {
    top: auto;
    bottom: 0.3rem;
    right: 50%;
    transform: translateX(50%);
  }

  .lb:has(.lb-input:checked) .lb-card.lb-box::after {
    transform: translateX(50%);
  }
</style>
