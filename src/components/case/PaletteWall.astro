---
/*
 * Parede de paletas: todas as paletas de um projeto lado a lado, cada uma com as suas cores em
 * faixas e o nome embaixo. É uma vista de conjunto (na Rota do Hub, as 51 paletas que o site
 * alterna). As cores são decorativas: cada item é lido pelo nome, e os códigos ficam no
 * atributo title para quem passa o ponteiro.
 */
interface Props {
  palettes: { name: string; colors: string[] }[];
  label: string;
}

const { palettes, label } = Astro.props;

// as cores de cada paleta numa faixa só, com cortes secos (um elemento por paleta, e não um por cor)
const faixa = (colors: string[]) =>
  `linear-gradient(90deg, ${colors.map((c, j) => `${c} ${(j * 100) / colors.length}% ${((j + 1) * 100) / colors.length}%`).join(', ')})`;
---

<ul class="list-reset pwall" aria-label={label} data-ambient>
  {
    palettes.map((p, i) => (
      <li class="pwall-item" data-reveal="scale" style={`--i:${i % 12}`} title={`${p.name}: ${p.colors.join(', ')}`}>
        <span class="pwall-colors" style={`background:${faixa(p.colors)}`} aria-hidden="true" />
        <span class="pwall-name">
          <span class="pwall-n" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {p.name}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .pwall {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.25rem), 1fr));
  }

  .pwall-item {
    display: grid;
    gap: 0.45rem;
    padding: 0.45rem 0.45rem 0.55rem;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-md);
    background: var(--c-surface-raised);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  .pwall-colors {
    display: block;
    height: 2.6rem;
    border-radius: calc(var(--radius-md) - 0.3rem);
    /* um fio na cor do texto: as amostras claras não somem no tema claro, nem as escuras no escuro */
    box-shadow: inset 0 0 0 1px rgb(var(--c-ink-rgb) / 0.1);
  }

  .pwall-name {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
    color: var(--c-ink);
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.3;
  }

  .pwall-n {
    flex: none;
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  @media (hover: hover) {
    .pwall-item:hover {
      transform: translateY(-3px) rotate(-1deg);
      box-shadow: var(--shadow-md);
    }
  }
</style>
