---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import type { Project } from '../data/profile';

interface Props {
  project: Project;
  image?: { src: ImageMetadata; alt: string };
  headingLevel?: 'h3' | 'h2';
}

const { project, image, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const typeIcon: Record<Project['type'], IconName> = {
  Desenvolvimento: 'code-xml',
  Extensão: 'users',
  Pesquisa: 'flask-conical',
  'Produção técnica': 'book-open',
  Web: 'layers',
};
const live = project.status === 'Em andamento';
---

<article class="card card-lift project-card" data-spotlight>
  {
    image && (
      <div class="project-media">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 560, 720]}
          sizes="(min-width: 62rem) 22rem, (min-width: 40rem) 45vw, 92vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
  <div class="project-meta">
    <span class="badge">
      <Icon name={typeIcon[project.type]} size={15} />
      {project.type}
    </span>
    <span class="status" data-live={live ? '' : undefined}>
      <span class="status-dot" aria-hidden="true"></span>
      {project.status}
    </span>
  </div>
  <Heading class="display-sm project-title">{project.title}</Heading>
  <p class="project-period">{project.period}</p>
  <p class="project-summary">{project.summary}</p>
  {project.note && <p class="project-note">{project.note}</p>}
  <ul class="chip-list" aria-label="Temas">
    {project.tags.map((tag) => <li class="chip">{tag}</li>)}
  </ul>
  {
    project.link && (
      <a class="link-arrow project-link" href={project.link.href} target="_blank" rel="noopener noreferrer">
        {project.link.label}
        <Icon name="arrow-up-right" size={16} class="icon-diagonal" />
        <span class="sr-only">: {project.title} (abre em nova aba)</span>
      </a>
    )
  }
</article>

<style>
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--c-canvas);
    border-color: var(--c-hairline);
    overflow: hidden;
  }

  .project-media {
    margin: calc(-1 * clamp(1.5rem, 1.2rem + 1vw, 2rem));
    margin-bottom: 0.5rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-surface-card);
    border-bottom: 1px solid var(--c-hairline);
  }

  .project-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.9s var(--ease-out);
  }

  @media (hover: hover) {
    .project-card:hover .project-media :global(img) {
      transform: scale(1.05);
    }
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .project-meta .badge {
    color: var(--c-ink);
  }

  .project-period {
    margin-top: -0.4rem;
    color: var(--c-muted);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .project-summary {
    color: var(--c-body);
  }

  .project-note {
    padding-inline-start: 0.85rem;
    border-inline-start: 2px solid var(--c-accent);
    color: var(--c-muted);
    font-size: var(--fs-body-sm);
  }

  .project-card .chip-list {
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .project-link {
    align-self: flex-start;
  }
</style>
