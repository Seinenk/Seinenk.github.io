---
import Icon from './Icon.astro';
import ProjectArt from './ProjectArt.astro';
import type { IconName } from './icons';
import { projectHref, type CaseStudy } from '../data/projects';

interface Props {
  project: CaseStudy;
  headingLevel?: 'h3' | 'h2';
}

const { project, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const typeIcon: Record<CaseStudy['type'], IconName> = {
  Desenvolvimento: 'code-xml',
  Pesquisa: 'flask-conical',
  'Produção técnica': 'book-open',
  Web: 'layers',
};
const live = project.status === 'Em andamento';
const href = projectHref(project.slug);
---

<!-- O cartão inteiro é clicável: o link do título se estende sobre ele (::after). -->
<article class="card card-lift project-card" data-spotlight>
  <div class="project-media">
    <ProjectArt kind={project.art} vt={`art-${project.slug}`} />
  </div>
  <div class="project-meta">
    <span class="badge">
      <Icon name={typeIcon[project.type]} size={15} />
      {project.type}
    </span>
    <span class="status" data-live={live ? '' : undefined}>
      <span class="status-dot" aria-hidden="true"></span>
      {project.status}
    </span>
  </div>
  <Heading class="display-sm project-title">
    <a class="project-link" href={href} style={`view-transition-name:title-${project.slug}`}>{project.title}</a>
  </Heading>
  <p class="project-period">{project.period}</p>
  <p class="project-summary">{project.summary}</p>
  <ul class="chip-list" aria-label="Temas">
    {project.tags.map((tag) => <li class="chip">{tag}</li>)}
  </ul>
  <span class="project-cta" aria-hidden="true">
    Ver o projeto
    <Icon name="arrow-right" size={17} class="icon-trail" />
  </span>
</article>

<style>
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--c-canvas);
    border-color: var(--c-hairline);
    overflow: hidden;
    cursor: pointer;
  }

  .project-card:has(.project-link:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }

  .project-media {
    margin: calc(-1 * clamp(1.5rem, 1.2rem + 1vw, 2rem));
    margin-bottom: 0.5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--c-hairline);
  }

  .project-media :global(.art) {
    transition: transform 0.9s var(--ease-out);
  }

  @media (hover: hover) {
    .project-card:hover .project-media :global(.art) {
      transform: scale(1.04);
    }
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .project-meta .badge {
    color: var(--c-ink);
  }

  .project-title {
    width: fit-content;
  }

  .project-link {
    color: inherit;
    text-decoration: none;
  }

  .project-link:focus-visible {
    outline: none;
  }

  /* o link cobre o cartão inteiro */
  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .project-period {
    margin-top: -0.4rem;
    color: var(--c-muted);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .project-summary {
    color: var(--c-body);
  }

  .project-card .chip-list {
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .project-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    color: var(--c-ink);
    font-weight: 500;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-block: 0.25rem;
    transition: background-size 0.45s var(--ease-out);
  }

  .project-cta :global(.icon) {
    transition: transform 0.45s var(--ease-out);
  }

  .project-card:hover .project-cta {
    background-size: 100% 1px;
  }

  .project-card:hover .project-cta :global(.icon) {
    transform: translateX(4px);
  }
</style>
