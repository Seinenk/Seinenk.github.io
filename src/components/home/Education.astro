---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { courses, education } from '../../data/profile';
---

<section id="formacao" class="section" aria-labelledby="formacao-title">
  <div class="container">
    <SectionHead
      kicker="03 — Formação"
      title="Uma trajetória inteira no *IFPI*"
      text="Do curso técnico em Informática à especialização em sistemas embarcados, com formação complementar em inovação, setor público e idiomas."
      id="formacao-title"
    />

    <ol class="list-reset edu-grid">
      {
        education.map((item, i) => (
          <li class="card card-lift edu-card" data-reveal style={`--i:${i}`} data-spotlight>
            <div class="edu-top">
              <span class="badge badge-outline">{item.level}</span>
              <span class="edu-period">{item.period}</span>
            </div>
            <h3 class="display-sm">{item.title}</h3>
            <p class="edu-org">
              <Icon name="graduation-cap" size={17} />
              {item.org}
            </p>
            <ul class="list-reset edu-details">
              {item.details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
            <span class="edu-index" aria-hidden="true">
              0{i + 1}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="courses">
      <h3 class="title-lg courses-title" data-reveal>Formação complementar</h3>
      <ul class="list-reset course-list">
        {
          courses.map((c, i) => (
            <li class="course" data-reveal style={`--i:${i}`}>
              <span class="course-period">{c.period}</span>
              <span class="course-main">
                <span class="course-name">{c.title}</span>
                <span class="course-org">{c.org}</span>
              </span>
              <span class="badge course-hours">{c.hours} h</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .edu-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .edu-card {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    overflow: hidden;
  }

  .edu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .edu-period {
    color: var(--c-muted);
    font-size: var(--fs-caption);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .edu-org {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-ink);
    font-weight: 500;
  }

  .edu-details {
    display: grid;
    gap: 0.4rem;
    color: var(--c-muted);
    font-size: var(--fs-body-sm);
  }

  .edu-details li {
    padding-inline-start: 1rem;
    position: relative;
  }

  .edu-details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--c-accent);
  }

  .edu-index {
    position: absolute;
    right: 1.25rem;
    bottom: -1.4rem;
    font-family: var(--font-display);
    font-size: 6rem;
    font-style: italic;
    line-height: 1;
    color: var(--c-ink);
    opacity: 0.06;
    pointer-events: none;
  }

  /* ---------- formação complementar ---------- */
  .courses {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .courses-title {
    margin-bottom: 1rem;
  }

  .course-list {
    border-top: 1px solid var(--c-hairline);
  }

  .course {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-hairline);
    transition: background-color 0.3s ease, padding 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .course:hover {
      background: var(--c-surface-soft);
      padding-inline: 0.75rem;
    }
  }

  .course-period {
    color: var(--c-muted);
    font-size: var(--fs-caption);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .course-main {
    display: grid;
    gap: 0.1rem;
  }

  .course-name {
    color: var(--c-ink);
    font-weight: 500;
  }

  .course-org {
    color: var(--c-muted);
    font-size: var(--fs-body-sm);
  }

  @media (max-width: 40rem) {
    .course {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 1rem;
    }

    .course-period {
      grid-column: 1 / -1;
    }
  }
</style>
