---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { languages, skills } from '../../data/profile';
import type { IconName } from '../icons';
---

<section id="competencias" class="section band-card" aria-labelledby="competencias-title">
  <div class="container">
    <SectionHead
      kicker="06 · Competências"
      title="O que eu *sei fazer*"
      text="As áreas em que trabalho e as ferramentas que uso em cada uma."
      id="competencias-title"
    />

    <ul class="list-reset skills-grid">
      {
        skills.map((group, i) => (
          <li class="card card-canvas card-lift skill" data-reveal style={`--i:${i % 3}`} data-spotlight>
            <span class="skill-icon">
              <Icon name={group.icon as IconName} size={22} />
            </span>
            <h3 class="title-lg">{group.area}</h3>
            <ul class="chip-list">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="langs">
      <h3 class="title-lg langs-title" data-reveal>
        <Icon name="languages" size={20} />
        Idiomas
      </h3>
      <ul class="list-reset langs-grid">
        {
          languages.map((lang, i) => (
            <li class="lang" data-reveal style={`--i:${i}`}>
              <p class="display-sm">{lang.name}</p>
              <p class="lang-summary">{lang.summary}</p>
              {lang.levels && (
                <dl class="lang-levels">
                  {lang.levels.map(([skill, level]) => (
                    <div>
                      <dt>{skill}</dt>
                      <dd>{level}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
  }

  /*
   * Cartões escuros, em escada: nas telas largas os pares descem, como etapas de um
   * processo. Cada área tem o seu tom de ícone (ciano, violeta ou areia).
   */
  .skill {
    --skill-tone: var(--c-inverse-cyan);
    --skill-tone-rgb: var(--c-inverse-cyan-rgb);
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: 17rem;
    overflow: hidden;
    border-color: var(--c-inverse-hairline);
    background:
      radial-gradient(120% 70% at 0% 0%, rgb(var(--skill-tone-rgb) / 0.12), transparent 60%),
      var(--c-inverse);
    color: var(--c-on-inverse-soft);
  }

  .skill:nth-child(3n + 2) {
    --skill-tone: var(--c-inverse-violet);
    --skill-tone-rgb: var(--c-inverse-violet-rgb);
  }

  .skill:nth-child(3n) {
    --skill-tone: var(--c-inverse-accent);
    --skill-tone-rgb: var(--c-inverse-accent-rgb);
  }

  .skill :global(.title-lg) {
    color: var(--c-on-inverse);
  }

  .skill :global(.chip) {
    border-color: var(--c-inverse-hairline);
    background: transparent;
    color: var(--c-on-inverse-soft);
  }

  @media (min-width: 75rem) {
    .skills-grid {
      align-items: start;
    }

    .skill:nth-child(even) {
      margin-top: 3.5rem;
    }
  }

  .skill-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: rgb(var(--skill-tone-rgb) / 0.12);
    color: var(--skill-tone);
    transition: transform 0.6s var(--ease-spring);
  }

  @media (hover: hover) {
    .skill:hover .skill-icon {
      transform: rotate(-8deg) scale(1.08);
    }
  }

  .langs {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .langs-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .langs-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .lang {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.4rem 1.5rem;
    border-top: 2px solid var(--c-ink);
    background: var(--c-canvas);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .lang-summary {
    color: var(--c-muted);
    font-size: var(--fs-body-sm);
  }

  .lang-levels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1rem;
    margin-top: 0.5rem;
  }

  .lang-levels dt {
    color: var(--c-muted);
    font-size: var(--fs-caption);
  }

  .lang-levels dd {
    color: var(--c-ink);
    font-weight: 500;
  }
</style>
