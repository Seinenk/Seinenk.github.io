---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { languages, skills } from '../../data/profile';
import type { IconName } from '../icons';
---

<section id="competencias" class="section band-card" aria-labelledby="competencias-title">
  <div class="container">
    <SectionHead
      kicker="06 — Competências"
      title="O que eu *trago* para cada projeto"
      text="Design, código e pesquisa caminhando juntos: da interface ao hardware, da ideia ao pitch."
      id="competencias-title"
    />

    <ul class="list-reset skills-grid">
      {
        skills.map((group, i) => (
          <li class="card card-canvas card-lift skill" data-reveal style={`--i:${i % 3}`} data-spotlight>
            <span class="skill-icon">
              <Icon name={group.icon as IconName} size={22} />
            </span>
            <h3 class="title-lg">{group.area}</h3>
            <ul class="chip-list">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="langs">
      <h3 class="title-lg langs-title" data-reveal>
        <Icon name="languages" size={20} />
        Idiomas
      </h3>
      <ul class="list-reset langs-grid">
        {
          languages.map((lang, i) => (
            <li class="lang" data-reveal style={`--i:${i}`}>
              <p class="display-sm">{lang.name}</p>
              <p class="lang-summary">{lang.summary}</p>
              {lang.levels && (
                <dl class="lang-levels">
                  {lang.levels.map(([skill, level]) => (
                    <div>
                      <dt>{skill}</dt>
                      <dd>{level}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .skill {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .skill-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--c-surface-card);
    color: var(--c-accent-strong);
    transition: transform 0.6s var(--ease-spring);
  }

  @media (hover: hover) {
    .skill:hover .skill-icon {
      transform: rotate(-8deg) scale(1.08);
    }
  }

  .langs {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .langs-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .langs-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .lang {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.4rem 1.5rem;
    border-top: 2px solid var(--c-ink);
    background: var(--c-canvas);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .lang-summary {
    color: var(--c-muted);
    font-size: var(--fs-body-sm);
  }

  .lang-levels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1rem;
    margin-top: 0.5rem;
  }

  .lang-levels dt {
    color: var(--c-muted);
    font-size: var(--fs-caption);
  }

  .lang-levels dd {
    color: var(--c-ink);
    font-weight: 500;
  }
</style>
