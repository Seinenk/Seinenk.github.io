---
import Icon from '../Icon.astro';
import { stats } from '../../data/profile';
---

<section class="stats band-card" aria-labelledby="numeros-title" data-ambient>
  <div class="container">
    <h2 id="numeros-title" class="sr-only">Números do currículo</h2>
    <ul class="list-reset stats-grid">
      {
        stats.map((s, i) => (
          <li class="stat" data-reveal style={`--i:${i}`} data-spotlight>
            <span class="stat-spark" aria-hidden="true">
              <Icon name="sparkles" size={16} />
            </span>
            <p class="display-xl stat-value">
              <span class="sr-only">
                {s.value}
                {s.suffix}
              </span>
              <span aria-hidden="true">
                <span data-count={s.value}>{s.value}</span>
                {s.suffix && <em>{s.suffix}</em>}
              </span>
            </p>
            <p class="stat-label">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }

  /* cada número num cartão, como uma ficha solta sobre a mesa */
  .stat {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: space-between;
    gap: 1.75rem;
    min-height: 13rem;
    padding: 1.5rem 1.5rem 1.4rem;
    border: 1px solid var(--c-hairline-soft);
    border-radius: var(--radius-lg);
    background: var(--c-surface-raised);
    transition:
      translate 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      border-color 0.3s ease;
  }

  /* os cartões pares descem um pouco nas telas largas, quebrando a linha reta */
  @media (min-width: 62rem) {
    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: start;
    }

    .stat:nth-child(even) {
      margin-top: 2rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .stat:hover {
      translate: 0 -6px;
      box-shadow: var(--shadow-md);
      border-color: var(--c-hairline);
    }

    .stat:hover .stat-spark {
      transform: rotate(90deg) scale(1.1);
    }
  }

  .stat-spark {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--c-cyan-soft);
    color: var(--c-cyan-strong);
    transition: transform 0.7s var(--ease-spring);
  }

  .stat:nth-child(even) .stat-spark {
    background: var(--c-violet-soft);
    color: var(--c-violet-strong);
  }

  :global(:root[data-motion='full']) .stat-spark :global(.icon) {
    animation: spark-twinkle 4.5s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -1.1s);
  }

  @keyframes spark-twinkle {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.82);
    }
  }

  .stat-value {
    font-variant-numeric: lining-nums tabular-nums;
  }

  .stat-value em {
    font-style: italic;
    color: var(--c-accent);
  }

  .stat-label {
    max-width: 16rem;
    color: var(--c-muted);
    font-size: var(--fs-body-sm);
  }
</style>
