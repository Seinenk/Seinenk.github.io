---
import { Image, Picture, getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import ProjectArt from '../ProjectArt.astro';
import cutout from '../../assets/images/carlos-recorte.webp';
import portrait from '../../assets/images/carlos-retrato.jpg';
import { links, profile, projects } from '../../data/profile';
import { projectHref } from '../../data/projects';

const social = [
  { ...links.github, icon: 'github' as const },
  { ...links.instagram, icon: 'instagram' as const },
  { ...links.orcid, icon: 'orcid' as const },
];
const chips = [
  { icon: 'graduation-cap' as const, text: 'ADS · IFPI', place: 'a' },
  { icon: 'briefcase' as const, text: 'Investe Piauí', place: 'b' },
  { icon: 'presentation' as const, text: 'Web Summit Lisboa 2025', place: 'c' },
];

// O projeto que abre a lista aparece no cartão solto ao lado do retrato.
const featured = projects[0];

// O brilho frio sobre o retrato usa o próprio recorte como máscara (só o contorno importa,
// então basta uma versão pequena e leve).
const tintMask = await getImage({ src: cutout, width: 420, format: 'webp', quality: 40 });

// Fios verticais do fundo, nas bordas e nos terços da largura do conteúdo.
const columns = [0, 33.333, 66.667, 100];
---

<section class="hero" aria-labelledby="hero-title" data-tilt-area data-ambient>
  <div class="hero-backdrop" aria-hidden="true">
    <span class="aura aura-a"></span>
    <span class="aura aura-b"></span>
    <span class="aura aura-c"></span>
    <span class="aura aura-d"></span>
    <svg class="honeycomb" width="100%" height="100%">
      <defs>
        <pattern id="honeycomb" width="56" height="100" patternUnits="userSpaceOnUse" patternTransform="scale(1.15)">
          <path d="M28 66 0 50V16L28 0l28 16v34L28 66v34" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#honeycomb)"></rect>
    </svg>
    <span class="rule rule-h rule-top"></span>
    <span class="rule rule-h rule-name"></span>
    <div class="container hero-rules">
      {columns.map((x, i) => <span class="rule rule-v" style={`--x:${x}%;--r:${i}`} />)}
      {columns.map((x, i) => <span class="mark mark-top" style={`--x:${x}%;--r:${i}`} />)}
      <span class="mark mark-name" style="--x:0%;--r:4"></span>
      <span class="mark mark-name mark-cool" style="--x:100%;--r:5"></span>
    </div>
  </div>

  <div class="container hero-stage">
    <div class="hero-name">
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line"><span style="--l:0">{profile.firstName}</span></span>{' '}
        <span class="hero-line"><span style="--l:1"><em>{profile.middleName}</em></span></span>{' '}
        <span class="hero-line hero-line-sm"><span style="--l:2">{profile.lastNames}</span></span>
      </h1>
    </div>

    <div class="hero-copy">
      <p class="kicker hero-enter" style="--d:0">Portfólio · {profile.location}</p>

      <p class="hero-role hero-enter" style="--d:420" data-typewriter data-words={JSON.stringify(profile.roles)}>
        <span class="sr-only">{profile.roles.join(', ')}.</span>
        <span aria-hidden="true">
          <span data-typewriter-text>{profile.roles[0]}</span><span class="caret"></span>
        </span>
      </p>

      <p class="hero-lead hero-enter" style="--d:520">{profile.lead}</p>

      <div class="hero-actions hero-enter" style="--d:620">
        <a class="btn btn-primary" href="#projetos">
          Ver projetos
          <Icon name="arrow-right" size={18} class="icon-trail" />
        </a>
        <a class="btn btn-secondary" href={links.lattes.href} target="_blank" rel="noopener noreferrer">
          Currículo Lattes
          <Icon name="arrow-up-right" size={18} class="icon-diagonal" />
          <span class="sr-only">(abre em nova aba)</span>
        </a>
      </div>

      <ul class="list-reset hero-social hero-enter" style="--d:720" aria-label="Perfis">
        {
          social.map((s) => (
            <li>
              <a class="icon-btn" href={s.href} target="_blank" rel="noopener noreferrer" title={s.label}>
                <Icon name={s.icon} size={18} />
                <span class="sr-only">{s.label} (abre em nova aba)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero-scene" data-tilt>
      <div class="scene-stage">
        <p class="hero-ghost" aria-hidden="true">{profile.firstName}</p>

        <div class="portrait-frame">
          <Picture
            src={cutout}
            alt="Retrato em preto e branco de Carlos Michael, de terno e camisa escuros, olhando para o lado."
            widths={[360, 480, 640, 800, 960, 1200, cutout.width]}
            sizes="(min-width: 64rem) 46rem, (min-width: 48rem) 58vw, 94vw"
            formats={['webp']}
            fallbackFormat="webp"
            quality={74}
            loading="eager"
            fetchpriority="high"
            class="portrait-img"
          />
          <span class="portrait-tint" style={`--mask:url('${tintMask.src}')`} aria-hidden="true"></span>
        </div>

      </div>

      <ul class="list-reset portrait-chips" aria-label="Destaques">
        {
          chips.map((c, i) => (
            <li class={`chip-float chip-${c.place}`} style={`--c:${i}`}>
              <Icon name={c.icon} size={16} />
              {c.text}
            </li>
          ))
        }
      </ul>
    </figure>

    <div class="hero-cards">
      <a class="hero-card hero-project hero-enter" style="--d:900" href={projectHref(featured.slug)}>
        <span class="hero-project-art">
          <ProjectArt kind={featured.art} />
        </span>
        <span class="hero-project-caption">
          <span class="hero-project-name">
            <Icon name="sparkles" size={14} />
            {featured.title}
          </span>
          <span class="hero-project-kind">/{featured.type}</span>
        </span>
        <span class="sr-only">Projeto em destaque: ver o estudo de caso</span>
      </a>

      <a class="hero-card hero-talk hero-enter" style="--d:1020" href="#contato">
        <Image
          src={portrait}
          alt=""
          width={172}
          height={172}
          position="top"
          fit="cover"
          quality={70}
          loading="eager"
          class="hero-talk-photo"
        />
        <span class="hero-talk-text">
          <span class="hero-talk-label">Vamos conversar</span>
          <span class="hero-talk-name">{profile.shortName}</span>
          <span class="hero-talk-role">Front-end e UX/UI</span>
        </span>
        <span class="hero-talk-go" aria-hidden="true">
          <Icon name="arrow-up-right" size={18} class="icon-diagonal" />
        </span>
        <Icon name="sparkles" size={13} class="hero-talk-spark" />
      </a>
    </div>
  </div>

  <a class="scroll-cue" href="#sobre">
    <span>Role para conhecer</span>
    <span class="scroll-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  /*
   * Topo da página inicial: um bloco na cor da paleta (taupe no claro, grafite no escuro)
   * com o retrato recortado no meio. Atrás dele, o primeiro nome em tamanho gigante;
   * na frente, o nome completo. Por cima, fios e cruzes de registro, como numa prancheta.
   */
  .hero {
    --c-focus: var(--c-on-hero);
    --c-cyan: var(--c-inverse-cyan);
    --c-violet: var(--c-inverse-violet);
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    /* o cabeçalho fica transparente por cima do bloco */
    margin-top: calc(-1 * var(--nav-h));
    /* medidas que o nome, o fio acima dele e o retrato compartilham */
    --hero-pad-b: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    --hero-name-size: clamp(3.5rem, 17.2vw, 7.25rem);
    --hero-shift: 0rem;
    padding-block: calc(var(--nav-h) + clamp(1.25rem, 0.8rem + 2vw, 2.75rem)) var(--hero-pad-b);
    background: linear-gradient(180deg, var(--c-hero) 0%, var(--c-hero-deep) 100%);
    color: var(--c-on-hero-soft);
  }

  @media (min-width: 48rem) {
    .hero {
      --hero-name-size: clamp(5.5rem, 13.4vw, 8.75rem);
    }
  }

  @media (min-width: 72rem) and (min-height: 40rem) {
    .hero {
      --hero-name-size: clamp(6.25rem, 10.2vw, 10rem);
      /* o retrato fica um pouco à direita do centro, e o nome de fundo compensa */
      --hero-shift: clamp(1.5rem, 4vw, 4.5rem);
      min-height: min(100svh, 62rem);
    }
  }

  /* ---------- fundo vivo ---------- */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .aura {
    position: absolute;
    width: 52vmax;
    height: 52vmax;
    border-radius: 50%;
    will-change: transform;
  }

  .aura-a {
    top: -20vmax;
    right: -10vmax;
    background: radial-gradient(closest-side, rgb(var(--c-glow-a-rgb) / var(--aura-a-alpha, 0.42)), transparent);
  }

  /*
   * No modo claro o bloco é taupe e o texto é claro: o brilho de areia e o nome fantasma
   * ficam mais fracos para o texto por cima manter o contraste AA (4,5:1).
   */
  :global(:root[data-mode='light']) .hero {
    --aura-a-alpha: 0.16;
    --ghost-alpha: 0.07;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-mode])) .hero {
      --aura-a-alpha: 0.16;
      --ghost-alpha: 0.07;
    }
  }

  .aura-b {
    bottom: -28vmax;
    left: -20vmax;
    background: radial-gradient(closest-side, rgb(var(--c-glow-b-rgb) / 0.26), transparent);
  }

  /* luz fria, bem de leve: ciano de um lado, violeta do outro */
  .aura-c {
    width: 38vmax;
    height: 38vmax;
    top: 8%;
    left: -12vmax;
    background: radial-gradient(closest-side, rgb(var(--c-inverse-violet-rgb) / 0.16), transparent);
  }

  .aura-d {
    width: 34vmax;
    height: 34vmax;
    bottom: -8vmax;
    right: -6vmax;
    background: radial-gradient(closest-side, rgb(var(--c-inverse-cyan-rgb) / 0.17), transparent);
  }

  :global(:root[data-motion='full']) .aura-a {
    animation: drift 18s ease-in-out infinite;
  }

  :global(:root[data-motion='full']) .aura-b {
    animation: drift 24s ease-in-out infinite reverse;
  }

  :global(:root[data-motion='full']) .aura-c {
    animation: drift 21s ease-in-out infinite;
    animation-delay: -6s;
  }

  :global(:root[data-motion='full']) .aura-d {
    animation: drift 27s ease-in-out infinite reverse;
    animation-delay: -11s;
  }

  .honeycomb {
    position: absolute;
    inset: 0;
    color: rgb(var(--c-on-hero-rgb) / 0.13);
    -webkit-mask-image: radial-gradient(ellipse 46% 56% at 58% 44%, #000 8%, transparent 70%);
    mask-image: radial-gradient(ellipse 46% 56% at 58% 44%, #000 8%, transparent 70%);
  }

  /* ---------- fios e cruzes de registro ---------- */
  .hero-rules {
    position: absolute;
    inset: 0;
    margin-inline: auto;
  }

  .rule {
    position: absolute;
    background: rgb(var(--c-on-hero-rgb) / 0.13);
  }

  .rule-v {
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
    transform-origin: 50% 0;
  }

  .rule-h {
    left: 0;
    right: 0;
    height: 1px;
    transform-origin: 0 50%;
  }

  .rule-top {
    top: calc(var(--nav-h) + 0.5rem);
  }

  /* fio logo acima do nome, só nas telas largas (onde o nome fica na base do bloco) */
  .rule-name,
  .mark-name {
    display: none;
  }

  @media (min-width: 72rem) and (min-height: 40rem) {
    .rule-name,
    .mark-name {
      display: block;
      top: auto;
      bottom: calc(var(--hero-pad-b) + var(--hero-name-size) * 0.9 + 4.5rem);
    }

    .mark.mark-name {
      translate: -50% 50%;
    }
  }

  .mark {
    position: absolute;
    left: var(--x);
    width: 0.875rem;
    height: 0.875rem;
    translate: -50% -50%;
    color: rgb(var(--c-on-hero-rgb) / 0.78);
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat;
  }

  .mark-top {
    top: calc(var(--nav-h) + 0.5rem);
  }

  .mark-cool {
    color: var(--c-inverse-cyan);
  }

  @media (max-width: 47.99rem) {
    .rule-v:nth-child(2),
    .rule-v:nth-child(3),
    .mark-top:nth-child(6),
    .mark-top:nth-child(7) {
      display: none;
    }
  }

  :global(:root[data-motion='full']) .rule-v {
    animation: grow-y 1.5s var(--ease-out) both;
    animation-delay: calc(var(--r) * 110ms + 100ms);
  }

  :global(:root[data-motion='full']) .rule-h {
    animation: grow-x 1.6s var(--ease-out) both 0.25s;
  }

  :global(:root[data-motion='full']) .mark {
    animation: mark-in 0.9s var(--ease-spring) both;
    animation-delay: calc(var(--r) * 110ms + 700ms);
  }

  :global(:root[data-motion='full']) .mark-cool {
    animation:
      mark-in 0.9s var(--ease-spring) both,
      mark-spin 9s var(--ease-in-out) infinite;
    animation-delay:
      calc(var(--r) * 110ms + 700ms),
      2.6s;
  }

  @keyframes mark-in {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.3);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mark-spin {
    0%,
    78% {
      rotate: 0deg;
    }
    100% {
      rotate: 180deg;
    }
  }

  /* ---------- grade ---------- */
  .hero-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'scene'
      'name'
      'copy'
      'chips'
      'cards';
    row-gap: clamp(1.5rem, 1.1rem + 2vw, 2.25rem);
  }

  .hero-name {
    grid-area: name;
    position: relative;
    z-index: 4;
    margin-top: clamp(-6.5rem, -22vw, -3.75rem);
    pointer-events: none;
  }

  .hero-copy {
    grid-area: copy;
    position: relative;
    z-index: 4;
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  .hero-scene {
    grid-area: scene;
    position: relative;
    z-index: 1;
    width: min(100%, 27rem);
    margin: 0;
    justify-self: center;
  }

  .hero-cards {
    grid-area: cards;
    position: relative;
    z-index: 4;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 34rem) and (max-width: 71.99rem) {
    .hero-cards {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      align-items: end;
    }
  }

  /* tablets: texto à esquerda, retrato à direita, nome embaixo */
  @media (min-width: 48rem) {
    .hero-stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'copy scene'
        'name name'
        'cards cards';
      align-items: start;
      column-gap: 1.5rem;
    }

    .hero-scene {
      width: min(100%, 30rem);
    }

    .hero-name {
      margin-top: clamp(-5.5rem, -9vw, -3.5rem);
    }

    /* o nome sobe por cima da linha anterior: a coluna de texto reserva esse espaço */
    .hero-copy {
      padding-bottom: 2.5rem;
    }
  }

  /* telas largas: retrato no centro, texto à esquerda, cartões à direita, nome por cima */
  @media (min-width: 72rem) and (min-height: 40rem) {
    .hero-stage {
      grid-template-columns: minmax(0, 23rem) minmax(0, 1fr) minmax(0, 20.5rem);
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas:
        'copy . cards'
        'name name cards';
      align-items: stretch;
      row-gap: 0;
    }

    .hero-copy {
      align-self: start;
      padding-top: clamp(1.5rem, 9svh, 6rem);
      padding-bottom: 0;
    }

    .hero-name {
      align-self: end;
      margin-top: 2.5rem;
    }

    .hero-cards {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
      padding-top: clamp(2.5rem, 15svh, 9.5rem);
    }

    /*
     * O retrato sai da grade e se prende à base do bloco. Como o bloco (.hero) também é
     * uma grade, a área precisa voltar a "auto": sem isso, o navegador procura a área
     * "scene" na grade do bloco, não acha, e o retrato fica com tamanho zero.
     */
    .hero-scene {
      grid-area: auto;
      justify-self: auto;
      position: absolute;
      bottom: 0;
      left: calc(50% + var(--hero-shift));
      translate: -50% 0;
      width: auto;
      height: min(calc(100% - var(--nav-h) - 1rem), 54rem);
    }
  }

  /* ---------- nome ---------- */
  .hero-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.2em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--hero-name-size);
    line-height: 0.9;
    letter-spacing: -0.035em;
    color: var(--c-on-hero);
    text-wrap: nowrap;
    text-shadow: 0 0.04em 0.6em rgb(var(--c-hero-deep-rgb) / 0.45);
  }

  .hero-title em {
    font-style: italic;
    color: var(--c-hero-accent);
  }

  .hero-line {
    display: block;
    overflow: clip;
    padding: 0.14em 0.12em 0.1em;
    margin: -0.14em -0.12em -0.1em;
  }

  .hero-line > span {
    display: inline-block;
  }

  .hero-line-sm {
    flex-basis: 100%;
    margin-top: 0.35rem;
    font-size: clamp(1.25rem, 1.05rem + 1vw, 1.875rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--c-on-hero-soft);
    text-shadow: none;
  }

  /* ---------- texto ---------- */
  .hero-copy .kicker {
    color: var(--c-on-hero);
  }

  .hero-role {
    display: flex;
    align-items: center;
    min-height: 1.6em;
    font-family: var(--font-display);
    font-size: var(--fs-display-sm);
    font-style: italic;
    color: var(--c-hero-accent);
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-inline-start: 0.2rem;
    background: currentColor;
    vertical-align: middle;
  }

  :global(:root[data-motion='full']) .caret {
    animation: blink 1.05s steps(1) infinite;
  }

  .hero-lead {
    max-width: 30rem;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--c-on-hero);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 26rem) {
    .hero-actions {
      gap: 0.5rem;
    }

    .hero-actions :global(.btn) {
      padding-inline: 1rem;
    }
  }

  /* botões sobre o bloco: o principal em claro, o secundário só no contorno */
  .hero :global(.btn-primary) {
    --btn-bg: var(--c-on-hero);
    --btn-fg: var(--c-hero-deep);
  }

  .hero :global(.btn-primary:is(:hover, :focus-visible)) {
    --btn-bg: var(--c-hero-accent);
  }

  .hero :global(.btn-secondary) {
    --btn-fg: var(--c-on-hero);
    --btn-border: rgb(var(--c-on-hero-rgb) / 0.5);
  }

  .hero :global(.btn-secondary:is(:hover, :focus-visible)) {
    --btn-bg: rgb(var(--c-on-hero-rgb) / 0.12);
    --btn-border: var(--c-on-hero);
  }

  .hero-social {
    display: flex;
    gap: 0.5rem;
  }

  .hero-social :global(.icon-btn) {
    border-color: rgb(var(--c-on-hero-rgb) / 0.34);
    background: rgb(var(--c-on-hero-rgb) / 0.06);
    color: var(--c-on-hero);
  }

  .hero-social :global(.icon-btn:hover) {
    border-color: var(--c-on-hero);
    background: rgb(var(--c-on-hero-rgb) / 0.16);
  }

  /* ---------- retrato recortado ---------- */
  .hero-scene {
    transform: perspective(1400px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 0.8s var(--ease-out);
    transform-style: preserve-3d;
  }

  .scene-stage {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
  }

  /* o primeiro nome em caixa alta atrás da cabeça, como o título de uma capa de revista */
  .hero-ghost {
    position: absolute;
    left: 50%;
    top: 3%;
    z-index: -1;
    translate: calc(-50% - var(--hero-shift)) 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(4.75rem, 25vw, 9.5rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(var(--c-on-hero-rgb) / var(--ghost-alpha, 0.12));
    transform: translateZ(-150px);
    -webkit-user-select: none;
    user-select: none;
  }

  @media (min-width: 48rem) {
    .hero-ghost {
      /* na coluna da direita: recua meia coluna para ficar no centro do conteúdo */
      left: -0.75rem;
      top: -3%;
      translate: -50% 0;
      font-size: clamp(11rem, 24vw, 15rem);
    }
  }

  @media (min-width: 72rem) and (min-height: 40rem) {
    .hero-ghost {
      left: 50%;
