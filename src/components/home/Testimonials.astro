---
import SectionHead from '../SectionHead.astro';
import TestimonialCard from '../TestimonialCard.astro';
import { formatRating, publishedTestimonials as items } from '../../data/testimonials';

const hasSamples = items.some((t) => t.sample);
const average = items.length ? items.reduce((sum, t) => sum + t.rating, 0) / items.length : 0;
const averageText = formatRating(Math.round(average * 10) / 10);
// a faixa que corre sozinha só faz sentido com vários cartões; com poucos, eles ficam lado a lado
const rail = items.length >= 3;
const intro = hasSamples
  ? 'O que dizem as pessoas que usaram ou acompanharam os projetos. Por enquanto, os depoimentos abaixo são exemplos e serão trocados pelos reais.'
  : 'O que dizem as pessoas que usaram ou acompanharam os projetos.';
---

{
  items.length > 0 && (
    <section id="depoimentos" class="section testimonials" aria-labelledby="depoimentos-title" data-ambient>
      <div class="container testimonials-head">
        <SectionHead kicker="05 · Depoimentos" title="O que dizem do meu *trabalho*" text={intro} id="depoimentos-title" />

        {
          items.length >= 2 && (
            <div class="t-summary" data-reveal="scale" style="--i:2">
              <p class="t-summary-score">
                <span class="sr-only">
                  Nota média {averageText} de 10, em {items.length} depoimentos
                  {hasSamples ? ' de exemplo' : ''}
                </span>
                <span aria-hidden="true">
                  {averageText}
                  <small>/10</small>
                </span>
              </p>
              <p class="t-summary-label" aria-hidden="true">
                Nota média em {items.length} depoimentos
              </p>
              <ul class="list-reset t-summary-faces" aria-hidden="true">
                {items.slice(0, 4).map((t) => (
                  <li>
                    {t.name
                      .split(/\s+/)
                      .filter((p) => p.length > 2)
                      .map((p) => p[0])
                      .slice(0, 1)
                      .join('')}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      {
        rail ? (
          <>
            {/*
              Faixa que corre sozinha: a lista de verdade e uma cópia decorativa (inerte, sem
              links), para a volta não ter emenda. Com o movimento desligado, vira uma lista que
              se rola com o dedo, e a cópia some.
            */}
            <div class="t-rail" data-reveal="fade">
              <div class="t-track">
                <ul class="list-reset t-group" aria-label="Depoimentos">
                  {items.map((item, i) => (
                    <li class="t-item">
                      <TestimonialCard item={item} flip={i % 2 === 1} />
                    </li>
                  ))}
                </ul>
                <ul class="list-reset t-group t-clone" aria-hidden="true" inert>
                  {items.map((item, i) => (
                    <li class="t-item">
                      <TestimonialCard item={item} flip={i % 2 === 1} decorative />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </>
        ) : (
          <div class="container">
            <ul class="list-reset t-static" aria-label="Depoimentos">
              {items.map((item, i) => (
                <li data-reveal style={`--i:${i}`}>
                  <TestimonialCard item={item} flip={i % 2 === 1} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  )
}

<style>
  .testimonials {
    overflow: clip;
  }

  .testimonials-head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }

  @media (min-width: 56rem) {
    .testimonials-head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  /* ---------- nota média, como o "4,9/5" da referência ---------- */
  .t-summary {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.25rem 1.25rem;
    justify-self: start;
    margin-bottom: clamp(2.5rem, 2rem + 2.4vw, 4.5rem);
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, rgb(var(--c-cyan-rgb) / 0.12), transparent 55%),
      radial-gradient(120% 140% at 0% 100%, rgb(var(--c-violet-rgb) / 0.1), transparent 55%),
      var(--c-surface-raised);
  }

  .t-summary-score {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2.2rem + 2vw, 3.75rem);
    line-height: 0.9;
    color: var(--c-ink);
  }

  .t-summary-score small {
    font-size: 0.42em;
    color: var(--c-muted);
  }

  .t-summary-label {
    color: var(--c-muted);
    font-size: var(--fs-caption);
  }

  .t-summary-faces {
    display: flex;
  }

  .t-summary-faces li {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-inline-end: -0.45rem;
    border: 2px solid var(--c-surface-raised);
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-cyan-strong), var(--c-violet-strong));
    color: var(--c-canvas);
    font-family: var(--font-display);
    font-size: 0.95rem;
  }

  .t-summary-faces li:nth-child(even) {
    background: linear-gradient(135deg, var(--c-violet-strong), var(--c-accent-strong));
  }

  /* ---------- poucos depoimentos: lado a lado, sem a faixa que corre ---------- */
  .t-static {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 40rem));
    align-items: start;
  }

  /* ---------- faixa de depoimentos ---------- */
  .t-rail {
    --t-gap: 1rem;
    --t-width: min(84vw, 23rem);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .t-track {
    display: flex;
    width: max-content;
  }

  .t-group {
    display: flex;
    align-items: stretch;
    gap: var(--t-gap);
    padding-inline-end: var(--t-gap);
  }

  .t-item {
    width: var(--t-width);
    flex: none;
  }

  /* os cartões ímpares começam mais abaixo, em escada */
  .t-item:nth-child(odd) {
    padding-top: 2.25rem;
  }

  :global(:root[data-motion='full']) .t-track {
    animation: marquee 70s linear infinite;
  }

  .t-rail:hover .t-track,
  .t-rail:focus-within .t-track {
    animation-play-state: paused;
  }

  /*
   * Quem navega pelo teclado: a faixa para de correr e vira uma lista rolável, para o
   * navegador conseguir mostrar o link que recebeu o foco.
   */
  .t-rail:has(:focus-visible) {
    overflow-x: auto;
    padding-inline: max(var(--gutter), (100% - var(--container)) / 2);
    -webkit-mask-image: none;
    mask-image: none;
  }

  .t-rail:has(:focus-visible) .t-track {
    animation: none;
  }

  .t-rail:has(:focus-visible) .t-clone {
    display: none;
  }

  /*
   * Sem movimento, e também sem JavaScript (quando não existe data-motion): a faixa vira
   * uma lista que se rola com o dedo, sem a cópia e sem o esmaecimento das bordas, e o
   * primeiro cartão começa alinhado à coluna do conteúdo.
   */
  :global(:root[data-motion='reduce']) .t-clone,
  :global(html:not([data-motion])) .t-clone {
    display: none;
  }

  :global(:root[data-motion='reduce']) .t-rail,
  :global(html:not([data-motion])) .t-rail {
    --t-inset: max(var(--gutter), (100% - var(--container)) / 2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--t-inset);
    padding-inline: var(--t-inset);
    padding-bottom: 0.75rem;
    -webkit-mask-image: none;
    mask-image: none;
  }

  :global(:root[data-motion='reduce']) .t-item,
  :global(html:not([data-motion])) .t-item {
    scroll-snap-align: start;
  }
</style>
