---
import Icon from '../Icon.astro';
import { links } from '../../data/profile';
---

<section id="contato" class="section contact" aria-labelledby="contato-title">
  <div class="container">
    <div class="contact-card" data-reveal="scale" data-ambient>
      <div class="contact-glow" aria-hidden="true"></div>
      <p class="kicker">07 — Contato</p>
      <h2 id="contato-title" class="display-lg">Vamos <em>conversar?</em></h2>
      <p class="contact-text">
        Me chame no Instagram ou conheça meus códigos no GitHub. A produção acadêmica está no Lattes e no ORCID.
      </p>
      <div class="contact-actions">
        <a class="btn btn-on-primary" href={links.instagram.href} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" size={18} />
          {links.instagram.handle}
          <span class="sr-only">no Instagram (abre em nova aba)</span>
        </a>
        <a class="btn btn-ghost-on-primary" href={links.github.href} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={18} />
          GitHub
          <span class="sr-only">(abre em nova aba)</span>
        </a>
        <a class="btn btn-ghost-on-primary" href={links.lattes.href} target="_blank" rel="noopener noreferrer">
          <Icon name="file-text" size={18} />
          Lattes
          <span class="sr-only">(abre em nova aba)</span>
        </a>
        <a class="btn btn-ghost-on-primary" href={links.orcid.href} target="_blank" rel="noopener noreferrer">
          <Icon name="orcid" size={18} />
          ORCID
          <span class="sr-only">(abre em nova aba)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(2.25rem, 1.5rem + 4vw, 4.5rem);
    border-radius: var(--radius-xl);
    background: var(--c-primary);
    color: var(--c-on-primary);
  }

  .contact-card .kicker,
  .contact-card h2,
  .contact-card h2 :global(em) {
    color: var(--c-on-primary);
  }

  .contact-text {
    max-width: 34rem;
    font-size: var(--fs-body-lg);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .contact-card :global(.btn-ghost-on-primary:is(:hover, :focus-visible)) {
    --btn-bg: rgb(255 255 255 / 0.12);
  }

  .contact-card :global(:focus-visible) {
    outline-color: var(--c-on-primary);
  }

  .contact-glow {
    position: absolute;
    z-index: -1;
    top: -40%;
    right: -15%;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.16), transparent);
  }

  :global(:root[data-motion='full']) .contact-glow {
    animation: drift 16s ease-in-out infinite;
  }
</style>
