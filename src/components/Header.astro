---
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import ThemeControls from './ThemeControls.astro';
import { links, profile } from '../data/profile';
import type { NavKey } from '../layouts/BaseLayout.astro';

interface Props {
  current: NavKey;
}

const { current } = Astro.props;

const nav = [
  { href: '/#sobre', label: 'Sobre', key: 'sobre' },
  { href: '/#trajetoria', label: 'Trajetória', key: 'trajetoria' },
  { href: '/projetos', label: 'Projetos', key: 'projetos' },
  { href: '/#contato', label: 'Contato', key: 'contato' },
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${profile.shortName}, página inicial`}>
      <Monogram size={38} class="brand-mark" />
      <span class="brand-name" aria-hidden="true">{profile.shortName}</span>
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul class="list-reset nav-list">
        {
          nav.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={item.key === current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeControls />
      <button
        class="icon-btn menu-button"
        type="button"
        aria-label="Abrir menu"
        aria-haspopup="dialog"
        aria-controls="menu-mobile"
        data-menu-open
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<dialog id="menu-mobile" class="menu-sheet" aria-label="Menu">
  <div class="container menu-inner">
    <div class="menu-top">
      <a class="brand" href="/" aria-label={`${profile.shortName}, página inicial`}>
        <Monogram size={38} />
        <span class="brand-name" aria-hidden="true">{profile.shortName}</span>
      </a>
      <button class="icon-btn" type="button" aria-label="Fechar menu" data-menu-close>
        <Icon name="x" size={20} />
      </button>
    </div>
    <nav aria-label="Menu principal">
      <ol class="list-reset menu-list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                class="menu-link"
                href={item.href}
                aria-current={item.key === current ? 'page' : undefined}
                data-menu-link
              >
                <span class="menu-index" aria-hidden="true">
                  0{i + 1}
                </span>
                <span class="display-md">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <ul class="list-reset menu-social">
      {
        [links.github, links.instagram, links.lattes, links.orcid].map((l) => (
          <li>
            <a class="link-arrow" href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}
              <Icon name="arrow-up-right" size={16} class="icon-diagonal" />
              <span class="sr-only">(abre em nova aba)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--nav-h);
    background: rgb(var(--c-canvas-rgb) / 0.8);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    backdrop-filter: saturate(1.4) blur(16px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.4s ease;
    view-transition-name: site-header;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--c-hairline);
    box-shadow: 0 10px 30px -24px rgb(var(--c-shadow-rgb) / 0.6);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--c-ink);
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  :global(.brand-mark) {
    transition: transform 0.6s var(--ease-spring);
  }

  .brand:hover :global(.brand-mark) {
    transform: rotate(-30deg) scale(1.05);
  }

  .nav-desktop {
    margin-inline-start: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-md);
    color: var(--c-muted);
    font-size: var(--fs-nav);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--c-ink);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 61.99rem) {
    .nav-desktop {
      display: none;
    }

    .header-actions {
      margin-inline-start: auto;
    }

    .menu-button {
      display: inline-grid;
    }
  }

  @media (max-width: 26rem) {
    .brand-name {
      display: none;
    }

    .header-actions {
      gap: 0.35rem;
    }
  }

  /* ---------- menu em tela cheia (celular e tablet) ---------- */
  .menu-sheet {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-canvas);
    color: var(--c-body);
    overflow-y: auto;
  }

  .menu-sheet::backdrop {
    background: rgb(var(--c-shadow-rgb) / 0.4);
  }

  .menu-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-xl);
  }

  .menu-top {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-list {
    display: grid;
    gap: 0.25rem;
    margin-top: clamp(1.5rem, 6vh, 3.5rem);
  }

  .menu-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--c-hairline);
    color: var(--c-ink);
    text-decoration: none;
  }

  .menu-link[aria-current='page'] .display-md {
    font-style: italic;
    color: var(--c-accent);
  }

  .menu-index {
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--c-muted);
    min-width: 1.75rem;
  }

  .menu-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: auto;
    padding-top: var(--space-xl);
  }

  :global(:root[data-motion='full']) .menu-sheet[open] .menu-list li {
    animation: fade-up 0.7s var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms + 80ms);
  }

  :global(:root[data-motion='full']) .menu-sheet[open] {
    animation: sheet-in 0.45s var(--ease-out);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-1.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
