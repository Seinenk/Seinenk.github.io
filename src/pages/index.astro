---
import LegacyLayout from '../layouts/LegacyLayout.astro';
---
<LegacyLayout title="Home" description="Uma página de apresentação de Carlos Michael com foto e uma descrição própria e de suas habilidades." bodyClass="body-index">

    <main>
        <section class="section-normal">
            <div class="parte-escrita">
                <div class="meu-nome">
                    <div class="titulo-1">
                        <h1 class="car">Car</h1>
                        <h1 class="mic">Mic</h1>
                    </div>
                    <div class="titulo-2">
                        <h1 class="los">los</h1>
                        <h1 class="hael">hael</h1>
                    </div>
                </div>
                <h2 class="subtitulo">Atualmente estudante do curso de análise e desenvolvimento de sistemas do Instituto Federal de Educação, Ciência e Tecnologia do Piauí campus Picos (IFPI)</h2>
            </div>
            <img class="imagem" src="images/foto-própria.webp" alt="Imagem principal">
        </section>

        <section class="section-especial">
            <h2 class="conteudo-secundario-titulo">Habilidades:</h2>
            <div class="conteudo-secundario-icones">
                <div class="html">
                    <i class="fa-brands fa-html5"></i>
                </div>
                <div class="css3">
                    <i class="fa-brands fa-css3-alt"></i>
                </div>
                <div class="python">
                    <i class="fa-brands fa-python"></i>
                </div>
                <div class="java">
                    <i class="fa-brands fa-java"></i>
                </div>
                <div class="steam">
                    <i class="fa-brands fa-steam"></i>
                </div>
            </div>
        </section>
    </main>
</LegacyLayout>
