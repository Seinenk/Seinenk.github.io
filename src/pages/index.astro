---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import About from '../components/home/About.astro';
import Stats from '../components/home/Stats.astro';
import Journey from '../components/home/Journey.astro';
import Education from '../components/home/Education.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import Achievements from '../components/home/Achievements.astro';
import Skills from '../components/home/Skills.astro';
import Contact from '../components/home/Contact.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title={`${profile.name} · Front-end, UX/UI e inovação`}
  description="Portfólio de Carlos Michael da Silva Sousa, desenvolvedor front-end e designer de UX/UI formado pelo IFPI. Trajetória, formação, projetos, prêmios e eventos."
  current="inicio"
>
  <Hero />
  <Marquee />
  <About />
  <Stats />
  <Journey />
  <Education />
  <FeaturedProjects />
  <Achievements />
  <Skills />
  <Contact />
</BaseLayout>
