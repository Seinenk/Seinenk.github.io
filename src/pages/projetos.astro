---
import LegacyLayout from '../layouts/LegacyLayout.astro';
---
<LegacyLayout title="Projetos" description="Acesso rápido aos projetos produzidos por carlos Michael com disposição de imagem." bodyClass="body-projetos">

    <main>
        <section class="section-normal">
            <div>
                <img class="imagem-projetos" src="images/primeiro-projeto.webp" alt="imagem da primeira atividade">
            </div>
            <div class="parte-escrita">
                <div class="titulo-separado">
                    <h1 class="titulo-1">Layout</h1>
                    <h1 class="titulo-2">Simples</h1>
                </div>
                <h2 class="subtitulo">Primeira atividade de Web</h2>
                <p class="texto">Atividade de iniciação dos alunos em html e css, onde o objetivo era copiar o layout passado pelo professor.</p>
                <div class="codigo">
                    <a href="https://github.com/Seinenk/Web-1/tree/master/Web-1" aria-label="Veja o código do primeiro projeto de Carlos Michael envolvendo html e css."><i class="fa-solid fa-code"></i></a>
                </div>
            </div>
        </section>

        <section class="section-normal">
            <div class="parte-escrita">
                <div class="titulo-portfolio">
                    <h1 class="titulo-1">Port</h1>
                    <h1 class="titulo-2">fólio</h1>
                </div>
                <h2 class="subtitulo">Segunda atividade de Web</h2>
                <p class="texto">Atividade de fixação dos alunos em html e css, onde o objetivo é criar uma página de portifólio dando foco ao design.</p>
                <div class="codigo">
                    <a href="https://github.com/Seinenk/Seinenk.github.io" aria-label="Veja o código do segundo projeto de Carlos Michael envolvendo html e css."><i class="fa-solid fa-code"></i></a>
                </div>
            </div>
            <div>
                <img class="imagem-projetos" src="images/segundo-projeto.webp" alt="imagem da segunda atividade">
            </div>
        </section>
    </main>
</LegacyLayout>
