---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { links } from '../data/profile';
import { projects, type ProjectType } from '../data/projects';

const filterKey: Record<ProjectType, string> = {
  Desenvolvimento: 'desenvolvimento',
  Pesquisa: 'pesquisa',
  'Produção técnica': 'producao',
  Web: 'web',
};

const filterLabel: Record<ProjectType, string> = {
  Desenvolvimento: 'Desenvolvimento',
  Pesquisa: 'Pesquisa',
  'Produção técnica': 'Produção técnica',
  Web: 'Web',
};

const types = (Object.keys(filterKey) as ProjectType[]).filter((t) => projects.some((p) => p.type === t));
---

<BaseLayout
  title="Projetos · Carlos Michael da Silva Sousa"
  description="Projetos de Carlos Michael, cada um com estudo de caso: Extractorys (app Flutter para Android), Agende Aí (SaaS), Bee Sense (IoT para abelhas sem ferrão), Dino Runner, INCLUA, pesquisa sobre pytest e este portfólio."
  current="projetos"
>
  <PageHero
    kicker="Projetos"
    title="Do protótipo ao *produto*"
    lead="Pesquisa e desenvolvimento, do app Android à Internet das Coisas, mais as atividades de Web que deram início a este portfólio. Cada projeto tem uma página com a história, as decisões e a construção visual."
  >
    <ul class="list-reset type-summary" aria-label="Projetos por tipo">
      {
        types.map((t, i) => (
          <li data-reveal style={`--i:${i + 2}`}>
            <span class="type-count">{projects.filter((p) => p.type === t).length}</span>
            <span class="type-name">{filterLabel[t]}</span>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section class="section band-soft projects-section" aria-labelledby="lista-title">
    <div class="container">
      <h2 id="lista-title" class="sr-only">Lista de projetos</h2>
      <div class="filters" role="group" aria-label="Filtrar projetos por tipo" data-filters hidden>
        <button class="filter" type="button" aria-pressed="true" data-filter="todos">
          Todos <span class="filter-count">{projects.length}</span>
        </button>
        {
          types.map((t) => (
            <button class="filter" type="button" aria-pressed="false" data-filter={filterKey[t]}>
              {filterLabel[t]} <span class="filter-count">{projects.filter((p) => p.type === t).length}</span>
            </button>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>

      <ul class="list-reset projects-grid">
        {
          projects.map((project, i) => (
            <li data-project-type={filterKey[project.type]} data-reveal style={`--i:${i % 3}`}>
              <ProjectCard project={project} headingLevel="h3" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section more" aria-labelledby="mais-title">
    <div class="container more-inner" data-reveal>
      <Icon name="github" size={40} />
      <h2 id="mais-title" class="display-md">Mais código no <em>GitHub</em></h2>
      <p>Repositórios de sistemas embarcados, IoT, FreeRTOS e as atividades da faculdade.</p>
      <a class="btn btn-primary" href={links.github.href} target="_blank" rel="noopener noreferrer">
        Ver perfil {links.github.handle}
        <Icon name="arrow-up-right" size={18} class="icon-diagonal" />
        <span class="sr-only">(abre em nova aba)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .type-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 2.5rem;
  }

  .type-summary li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .type-count {
    font-family: var(--font-display);
    font-size: var(--fs-display-md);
    font-style: italic;
    line-height: 1;
    color: var(--c-accent);
  }

  .type-name {
    color: var(--c-muted);
    font-weight: 500;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .filters[hidden] {
    display: none;
  }

  /* abas do design system (category-tab) */
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--c-muted);
    font-size: var(--fs-nav);
    font-weight: 500;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .filter:hover {
    color: var(--c-ink);
    border-color: var(--c-outline);
  }

  .filter[aria-pressed='true'] {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-canvas);
  }

  .filter-count {
    font-size: var(--fs-caption);
    opacity: 0.8;
  }

  .projects-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .projects-grid li[hidden] {
    display: none;
  }

  .more-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 38rem;
    text-align: center;
    color: var(--c-ink);
  }

  .more-inner p {
    color: var(--c-muted);
  }

  .more-inner .btn {
    margin-top: 0.5rem;
  }
</style>
