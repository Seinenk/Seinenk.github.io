---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/icons';
import SectionHead from '../../components/SectionHead.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import ProjectDiagram from '../../components/case/ProjectDiagram.astro';
import Palette from '../../components/case/Palette.astro';
import TypeSpecimens from '../../components/case/TypeSpecimens.astro';
import Gallery from '../../components/case/Gallery.astro';
import ExtractorysMark from '../../components/case/ExtractorysMark.astro';
import EfiplaMark from '../../components/case/EfiplaMark.astro';
import BeeSenseMark from '../../components/case/BeeSenseMark.astro';
import CrohneaseMark from '../../components/case/CrohneaseMark.astro';
import VanmedMark from '../../components/case/VanmedMark.astro';
import RotaDoHubMark from '../../components/case/RotaDoHubMark.astro';
import PaletteWall from '../../components/case/PaletteWall.astro';
import PaletteSwap from '../../components/case/PaletteSwap.astro';
import ThemePlayground from '../../components/case/ThemePlayground.astro';
import DinoGame from '../../components/case/DinoGame.astro';
import BeforeAfter from '../../components/case/BeforeAfter.astro';
import LayoutBoxes from '../../components/case/LayoutBoxes.astro';
import PytestRun from '../../components/case/PytestRun.astro';
import VideoEmbed from '../../components/case/VideoEmbed.astro';
import ScreenShowcase from '../../components/case/ScreenShowcase.astro';
import ScreenStory from '../../components/case/ScreenStory.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { projects, nextProject, projectHref, type CaseStudy } from '../../data/projects';
import type { ArtKind } from '../../data/projects/types';
import { testimonialsFor } from '../../data/testimonials';
import { plain, readingMinutes, rich } from '../../utils/rich';
import { pageFontCss } from '../../utils/page-fonts';

/*
 * Página de cada projeto, montada como a landing page de um produto: um cartão escuro no
 * topo (com os botões do projeto e o desenho dele), a barra do produto presa no alto com os
 * tópicos, faixas largas que alternam o fundo, funções em mosaico (bento), os números numa
 * faixa escura e, no fim, o convite para o próximo projeto. O conteúdo vem todo dos dados
 * (src/data/projects); aqui só muda a forma de mostrar.
 */

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CaseStudy;
}

const { project: p } = Astro.props;
const next = nextProject(p.slug);
const pageFonts = p.fonts ? pageFontCss(p.fonts) : null;
const live = p.status === 'Em andamento';
const quotes = testimonialsFor(p.slug);
/* apps com etapas nas telas ganham o passo a passo antes da galeria */
const hasStory = (p.visual?.gallery ?? []).filter((s) => s.frame === 'phone' && s.story).length >= 2;

/* Seções presentes, na ordem da página. O número entra no sobretítulo. */
const doVerb = p.type === 'Pesquisa' ? 'O que a pesquisa *cobre*' : p.type === 'Produção técnica' ? 'O que ela *reúne*' : 'O que ele *faz*';
const emphasizeLast = (title: string) => {
  const words = title.split(' ');
  return words.length > 1 ? `${words.slice(0, -1).join(' ')} *${words.at(-1)}*` : `*${title}*`;
};
/* desenho da marca, por projeto (o texto vem dos dados) */
const marks = {
  extractorys: ExtractorysMark,
  efipla: EfiplaMark,
  'bee-sense': BeeSenseMark,
  crohnease: CrohneaseMark,
  vanmed: VanmedMark,
  'rota-do-hub': RotaDoHubMark,
} as const;
const Mark = p.art in marks ? marks[p.art as keyof typeof marks] : null;
const hasVisual = Boolean(
  p.visual && (p.visual.palette || p.visual.paletteWall || p.visual.appThemes || p.visual.typography || p.visual.tokens || p.visual.gallery || p.visual.mark),
);
type TabId = 'resumo' | 'pesquisa' | 'ux-ui' | 'construcao' | 'aprendizado';
/* Os tópicos (abas), por área de atuação. Um tópico só aparece se o projeto tem alguma seção dele. */
const tabDefs: { id: TabId; label: string; icon: IconName }[] = [
  { id: 'resumo', label: 'Resumo', icon: 'file-text' },
  { id: 'pesquisa', label: 'Pesquisa e estruturação', icon: 'search' },
  { id: 'ux-ui', label: 'UX/UI', icon: 'pen-tool' },
  { id: 'construcao', label: 'Construção', icon: 'wrench' },
  { id: 'aprendizado', label: 'Aprendizado', icon: 'lightbulb' },
];
const defs = {
  contexto: { label: 'Contexto', title: 'O *contexto*', on: true },
  funcoes: { label: 'Funções', title: doVerb, on: Boolean(p.features?.length) },
  video: { label: 'Vídeo', title: 'O projeto *funcionando*', on: Boolean(p.video) },
  resultados: { label: 'Resultados', title: 'Os *resultados*', on: Boolean(p.results) },
  depoimentos: { label: 'Depoimentos', title: 'O que *disseram*', on: quotes.length > 0 },
  desafio: { label: 'Desafio', title: 'O *problema*', on: Boolean(p.challenge) },
  'por-dentro': { label: 'Por dentro', title: p.inside ? emphasizeLast(p.inside.title) : '', on: Boolean(p.inside) },
  decisoes: { label: 'Decisões', title: 'Decisões e *motivos*', on: Boolean(p.decisions?.length) },
  'na-pratica': { label: p.demo?.title ?? '', title: p.demo ? emphasizeLast(p.demo.title) : '', on: Boolean(p.demo) },
  visual: { label: 'Visual', title: 'A parte *visual*', on: hasVisual },
  processo: { label: 'Processo', title: 'Como foi *construído*', on: Boolean(p.story?.length) },
  campo: { label: 'Em campo', title: 'O teste em *campo*', on: Boolean(p.fieldwork?.shots.length) },
  tecnologias: { label: 'Tecnologias', title: 'As ferramentas *usadas*', on: Boolean(p.tech?.length) },
  habilidades: { label: 'Habilidades', title: 'O que eu *pratiquei*', on: Boolean(p.skills?.length) },
  aprendizados: { label: 'Aprendizados', title: 'Dificuldades e *lições*', on: Boolean(p.lessons?.length) },
  proximos: { label: 'Próximos passos', title: 'Próximos *passos*', on: Boolean(p.next?.length) },
  creditos: { label: 'Créditos', title: 'Quem fez *comigo*', on: Boolean(p.credits?.length) },
};
type SectionId = keyof typeof defs;
// a demonstração do pytest é rodar os testes: é construção, não interface
const demoInBuild = p.demo?.kind === 'pytest-run';
const groups: Record<TabId, SectionId[]> = {
  resumo: ['contexto', 'funcoes', 'video', 'resultados', 'depoimentos'],
  pesquisa: ['desafio', 'por-dentro', 'decisoes'],
  'ux-ui': demoInBuild ? ['visual'] : ['na-pratica', 'visual'],
  construcao: demoInBuild ? ['processo', 'campo', 'na-pratica', 'tecnologias'] : ['processo', 'campo', 'tecnologias'],
  aprendizado: ['habilidades', 'aprendizados', 'proximos', 'creditos'],
};
/* Seções presentes, na ordem da página (tópico por tópico). O número entra no sobretítulo. */
const sections = tabDefs.flatMap((t) => groups[t.id].filter((id) => defs[id].on).map((id) => ({ id, tab: t.id, ...defs[id] })));
const tabs = tabDefs.filter((t) => sections.some((s) => s.tab === t.id));
const sectionsOf = (tab: TabId) => sections.filter((s) => s.tab === tab);
const head = (id: SectionId) => {
  const i = sections.findIndex((s) => s.id === id);
  const s = sections[i];
  return { kicker: `${String(i + 1).padStart(2, '0')} · ${s.label}`, title: s.title, id: `${id}-titulo` };
};

/*
 * Fundo de cada faixa, como numa landing page: claro e areia se alternam, e os números
 * (resultados) e as ferramentas (tecnologias) ganham a faixa escura. Duas faixas escuras
 * nunca ficam coladas.
 */
type Tone = 'canvas' | 'soft' | 'inverse';
const darkSections: SectionId[] = ['resultados', 'tecnologias'];
const tones = {} as Record<SectionId, Tone>;
let previousTone: Tone = 'soft';
for (const s of sections) {
  const tone: Tone = darkSections.includes(s.id) && previousTone !== 'inverse' ? 'inverse' : previousTone === 'soft' ? 'canvas' : 'soft';
  tones[s.id] = tone;
  previousTone = tone;
}
/* seções com o título centralizado (as de vitrine); as outras abrem à esquerda */
const centered: SectionId[] = ['funcoes', 'video', 'resultados', 'depoimentos', 'na-pratica', 'processo', 'campo', 'tecnologias'];
const headClass = (id: SectionId) => (centered.includes(id) ? 'lp-head-center' : undefined);

/*
 * Duas cores de cada projeto, tiradas das paletas e dos desenhos dele. Pintam só os brilhos
 * decorativos do topo, o selo da barra e o convite para o próximo projeto: nenhum texto
 * depende delas para ser lido.
 */
const brandTint: Partial<Record<ArtKind, [string, string]>> = {
  extractorys: ['#800080', '#D50048'],
  efipla: ['#6750A4', '#FFD700'],
  'bee-sense': ['#EDB039', '#1B9DDA'],
  crohnease: ['#00BBC9', '#007F8F'],
  vanmed: ['#5D00FF', '#FF2E9A'],
  'rota-do-hub': ['#E98B9C', '#F6C81E'],
  'trilha-da-protecao': ['#FE8B2C', '#6AAB4E'],
  'agende-ai': ['#FF5800', '#D91C0D'],
  'dino-runner': ['#4F6BFF', '#FF4B4B'],
  'layout-simples': ['#8E7CC3', '#6FA8DC'],
  portfolio: ['#8A7875', '#248DAA'],
  pytest: ['#248DAA', '#7E74C0'],
  inclua: ['#7E74C0', '#248DAA'],
};
/* um projeto novo, ainda fora do mapa, fica com o ciano e o violeta do site */
const tint = (kind: ArtKind) => {
  const [a, b] = brandTint[kind] ?? ['#248DAA', '#7E74C0'];
  return `--brand-a:${a};--brand-b:${b}`;
};

/* faixa de ferramentas logo abaixo do topo (repete as da seção Tecnologias, em movimento) */
const techItems = [...new Set((p.tech ?? []).flatMap((g) => g.items))];
const tickerHalf: string[] = [];
while (techItems.length && tickerHalf.length < 10) tickerHalf.push(...techItems);
const cta = p.links?.[0];

const texts = [
  p.tagline,
  ...p.context,
  p.challenge?.problem ?? '',
  ...(p.challenge?.goals ?? []),
  ...(p.story ?? []).flatMap((s) => [s.title, s.text]),
  ...(p.features ?? []).flatMap((f) => [f.title, f.text]),
  p.video?.text ?? '',
  ...(p.inside?.text ?? []),
  ...(p.decisions ?? []).flatMap((d) => [d.title, d.why, d.tradeoff ?? '']),
  p.visual?.intro ?? '',
  p.visual?.appThemesText ?? '',
  p.visual?.mark ?? '',
  p.visual?.galleryNote ?? '',
  p.fieldwork?.text ?? '',
  ...(p.skills ?? []).flatMap((s) => [s.title, s.text]),
  ...(p.results?.highlights ?? []),
  ...(p.lessons ?? []).flatMap((l) => [l.title, l.text]),
  ...(p.next ?? []),
].map(plain);
const minutes = readingMinutes(texts);
const titleWords = p.title.split(' ');
const metricIcons: IconName[] = ['trending-up', 'target', 'sparkles', 'zap'];
const metricCount = p.results?.metrics?.length ?? 0;

/*
 * Cartões por linha (no máximo `max`): o número que deixa a última linha mais cheia. A sobra
 * fica centralizada, com a mesma largura das outras. Um cartão sozinho ganha meia largura.
 */
const perRow = (n: number, max = 3) => {
  if (n <= 1) return 2;
  if (n <= max) return n;
  let best = max;
  let bestFill = 0;
  for (let c = max; c >= 2; c--) {
    const rest = n % c;
    const fill = rest === 0 ? 1 : rest / c;
    if (fill > bestFill + 1e-9) {
      best = c;
      bestFill = fill;
    }
  }
  return best;
};
const flow = (n: number, max = 3) => `--per-row:${perRow(n, max)}`;
---

<BaseLayout title={`${p.title} · Projetos · Carlos Michael`} description={plain(p.summary)} current="projetos">
  {
    pageFonts && (
      <Fragment slot="head">
        <style is:inline set:html={pageFonts.vars} />
        {/* desligada (media="print") até a seção visual chegar perto; sem JavaScript, carrega já */}
        <style is:inline media="print" data-lazy-fonts set:html={pageFonts.faces} />
        <noscript>
          <style is:inline set:html={pageFonts.faces} />
        </noscript>
      </Fragment>
    )
  }
  <article class="cs" data-case style={tint(p.art)}>
    {/* barra do produto: o nome à esquerda, os tópicos no meio e o botão principal à direita */}
    <div class="cs-tabs-bar" data-tabs-bar>
      <div class="container lp-bar">
        <a class="lp-bar-brand" href="#topo" data-to-top>
          <span class="lp-bar-tile" aria-hidden="true">{p.title.charAt(0)}</span>
          <span class="lp-bar-name">{p.title}</span>
        </a>
        <nav class="cs-tabs-nav" aria-label="Tópicos do projeto">
          <div class="cs-tabs" data-tablist>
            {
              tabs.map((t) => (
                <a class="cs-tab" href={`#aba-${t.id}`} data-tab-link={t.id}>
                  <Icon name={t.icon} size={16} />
                  <span>{t.label}</span>
                </a>
              ))
            }
            <span class="cs-tabs-ink" aria-hidden="true"></span>
          </div>
        </nav>
        {
          cta && (
            <a class="btn btn-primary lp-bar-cta" href={cta.href} target="_blank" rel="noopener noreferrer">
              {cta.icon && <Icon name={cta.icon} size={16} />}
              {cta.label}
              <Icon name="arrow-up-right" size={15} class="icon-diagonal" />
              <span class="sr-only">(abre em nova aba)</span>
            </a>
          )
        }
      </div>
    </div>

    <header class="cs-hero" id="topo" data-tilt-area data-ambient>
      <div class="lp-hero-panel">
        <div class="lp-backdrop" aria-hidden="true">
          <span class="lp-glow lp-glow-a"></span>
          <span class="lp-glow lp-glow-b"></span>
          <span class="lp-grid"></span>
        </div>
        <div class="container lp-hero-inner">
          <a class="lp-back" href="/projetos">
            <Icon name="arrow-left" size={16} />
            Todos os projetos
          </a>
          <div class="cs-hero-grid">
            <div class="cs-hero-text">
              <p class="lp-eyebrow" data-reveal="fade">
                <span class="status" data-live={live ? '' : undefined}>
                  <span class="status-dot" aria-hidden="true"></span>
                  {p.status}
                </span>
                <span class="lp-eyebrow-sep" aria-hidden="true"></span>
                <span>{p.type} · {p.period}</span>
              </p>
              <h1 class="display-xl cs-title" tabindex="-1" style={`view-transition-name:title-${p.slug}`}>
                {titleWords.map((w, i) => (i === titleWords.length - 1 && titleWords.length > 1 ? <em>{w}</em> : <>{w} </>))}
              </h1>
              <p class="cs-tagline" data-reveal style="--i:1">{p.tagline}</p>
              {
                p.links && (
                  <div class="cs-links" data-reveal style="--i:2">
                    {p.links.map((link, i) => (
                      <a class:list={['btn', i === 0 ? 'lp-btn-light' : 'btn-on-inverse']} href={link.href} target="_blank" rel="noopener noreferrer">
                        {link.icon && <Icon name={link.icon} size={17} />}
                        {link.label}
                        <Icon name="arrow-up-right" size={16} class="icon-diagonal" />
                        <span class="sr-only">(abre em nova aba)</span>
                      </a>
                    ))}
                  </div>
                )
              }
              <ul class="list-reset cs-tags" data-reveal style="--i:3" aria-label="Temas do projeto">
                {p.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <p class="cs-read" data-reveal style="--i:4">
                <Icon name="clock" size={15} />
                Leitura de {minutes} min
              </p>
            </div>
            <div class="cs-hero-art">
              <div class="lp-art-frame">
                <div class="cs-tilt" data-tilt>
                  <ProjectArt kind={p.art} size="hero" vt={`art-${p.slug}`} />
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="lp-facts-bar">
          <dl class="container cs-facts">
            {
              p.facts.map((f, i) => (
                <div class="cs-fact" data-reveal style={`--i:${i}`}>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </header>

    {
      tickerHalf.length > 0 && (
        <div class="lp-ticker" aria-hidden="true" data-ambient>
          <div class="container lp-ticker-inner">
            <span class="lp-ticker-label">Tecnologias</span>
            <div class="lp-ticker-viewport">
              <ul class="list-reset lp-ticker-track">
                {[...tickerHalf, ...tickerHalf].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )
    }

    {/* índice das seções: um trilho na borda direita, nas telas largas */}
    <aside class="cs-aside">
      <nav class="cs-toc" aria-labelledby="toc-titulo" data-toc>
        <p class="cs-toc-title" id="toc-titulo">
          <Icon name="list" size={16} />
          <span>Nesta página</span>
        </p>
        <ol class="list-reset">
          {
            sections.map((s, i) => (
              <li data-tab={s.tab} data-first={i > 0 && sections[i - 1].tab !== s.tab ? '' : undefined}>
                <a href={`#${s.id}`} data-toc-link>
                  <span class="cs-toc-label">{s.label}</span>
                  <span class="cs-toc-n">{String(i + 1).padStart(2, '0')}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <div class="cs-main">
      {
        tabs.map((t, ti) => {
          const prev = tabs[ti - 1];
          const after = tabs[ti + 1];
          const list = sectionsOf(t.id);
          const lastTone = tones[list[list.length - 1].id];
          return (
            <div class="cs-panel" id={`aba-${t.id}`} data-panel={t.id}>
              {list.map((s, si) => (
                <section
                  id={s.id}
                  class:list={['cs-section', 'lp-band', `lp-${s.id}`, { 'band-inverse': tones[s.id] === 'inverse' }]}
                  data-tone={tones[s.id]}
                  aria-labelledby={`${s.id}-titulo`}
                >
                  <div class="container">
                    {si === 0 && (
                      <div class="lp-chapter" data-reveal="fade">
                        <p class="cs-area">
                          <Icon name={t.icon} size={16} />
                          {t.label}
                        </p>
                        <span class="lp-chapter-line" aria-hidden="true" />
                        <span class="lp-chapter-n" aria-hidden="true">
                          {String(ti + 1).padStart(2, '0')} / {String(tabs.length).padStart(2, '0')}
                        </span>
                      </div>
                    )}
                    {s.id === 'contexto' && (
                      <div class="lp-split">
                        <div class="lp-split-head">
                          <SectionHead {...head('contexto')} size="md" />
                        </div>
                        <div class="cs-prose">
                          {p.context.map((t, i) => (
                            <p class:list={{ 'cs-lead': i === 0 }} data-reveal style={`--i:${i}`} set:html={rich(t)} />
                          ))}
                        </div>
                      </div>
                    )}
                    {s.id === 'desafio' && p.challenge && (
                      <>
                        <SectionHead {...head('desafio')} size="md" />
                        <div class:list={['lp-problem-grid', { 'has-goals': p.challenge.goals?.length }]}>
                          <blockquote class="cs-problem" data-reveal>
                            <Icon name="target" size={26} />
                            <p set:html={rich(p.challenge.problem)} />
                          </blockquote>
                          {p.challenge.goals && (
                            <div class="lp-goals">
                              <h3 class="cs-sub" data-reveal>
                                Objetivos
                              </h3>
                              <ol class="list-reset cs-goals">
                                {p.challenge.goals.map((g, i) => (
                                  <li data-reveal style={`--i:${i}`}>
                                    <span class="cs-goal-n" aria-hidden="true">
                                      {String(i + 1).padStart(2, '0')}
                                    </span>
                                    <span set:html={rich(g)} />
                                  </li>
                                ))}
                              </ol>
                            </div>
                          )}
                        </div>
                      </>
                    )}
                    {s.id === 'processo' && p.story && (
                      <>
                        <SectionHead {...head('processo')} size="md" class={headClass('processo')} />
                        <ol class="list-reset cs-timeline">
                          {p.story.map((s, i) => (
                            <li class="cs-step" data-reveal style={`--i:${i % 3}`}>
                              <span class="cs-step-dot" aria-hidden="true" />
                              <p class="cs-step-date">{s.date}</p>
                              <h3 class="cs-step-title">{s.title}</h3>
                              <p class="cs-step-text" set:html={rich(s.text)} />
                            </li>
                          ))}
                        </ol>
                      </>
                    )}
                    {s.id === 'campo' && p.fieldwork && (
                      <>
                        <SectionHead {...head('campo')} size="md" text={p.fieldwork.text} class={headClass('campo')} />
                        <Gallery shots={p.fieldwork.shots} label={`Fotos dos testes do projeto ${p.title}`} />
                        {p.fieldwork.note && (
                          <p class="cs-gallery-note" data-reveal>
                            <Icon name="map-pin" size={15} />
                            <span set:html={rich(p.fieldwork.note)} />
                          </p>
                        )}
                      </>
                    )}
                    {s.id === 'funcoes' && p.features && (
                      <>
                        <SectionHead {...head('funcoes')} size="md" class={headClass('funcoes')} />
                        <ul class="list-reset cs-features" data-ambient>
                          {p.features.map((f, i) => (
                            <li class="card card-canvas card-lift cs-feature" data-spotlight data-reveal style={`--i:${i % 3}`}>
                              <span class="cs-feature-n" aria-hidden="true">
                                {String(i + 1).padStart(2, '0')}
                              </span>
                              <span class="cs-feature-icon" aria-hidden="true">
                                <Icon name={f.icon} size={22} />
                              </span>
                              <h3 class="cs-feature-title">{f.title}</h3>
                              <p set:html={rich(f.text)} />
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                    {s.id === 'video' && p.video && (
                      <>
                        <SectionHead {...head('video')} size="md" text={p.video.text} class={headClass('video')} />
                        <div class="lp-stage lp-stage-video" data-reveal>
                          <VideoEmbed video={p.video} art={p.art} />
                        </div>
                      </>
                    )}
                    {s.id === 'por-dentro' && p.inside && (
                      <>
                        <div class="lp-split">
                          <div class="lp-split-head">
