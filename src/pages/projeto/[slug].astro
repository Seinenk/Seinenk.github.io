                      <span class="cs-tabnav-text">
                        <span class="cs-tabnav-small">Próxima aba</span>
                        {after.label}
                      </span>
                      <Icon name="arrow-right" size={18} class="icon-trail" />
                    </a>
                  )}
                </nav>
              </div>
            );
          })
        }

        {p.sources && <p class="cs-sources">Fontes desta página: {p.sources}</p>}
      </div>
    </div>
    </div>

    <nav class="cs-next band-inverse" aria-label="Próximo projeto">
      <a class="cs-next-link" href={projectHref(next.slug)}>
        <div class="container cs-next-inner">
          <div class="cs-next-text">
            <span class="cs-next-kicker">Próximo projeto</span>
