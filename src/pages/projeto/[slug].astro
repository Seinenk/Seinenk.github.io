---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/icons';
import SectionHead from '../../components/SectionHead.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import ProjectDiagram from '../../components/case/ProjectDiagram.astro';
import Palette from '../../components/case/Palette.astro';
import TypeSpecimens from '../../components/case/TypeSpecimens.astro';
import Gallery from '../../components/case/Gallery.astro';
import ExtractorysMark from '../../components/case/ExtractorysMark.astro';
import EfiplaMark from '../../components/case/EfiplaMark.astro';
import BeeSenseMark from '../../components/case/BeeSenseMark.astro';
import ThemePlayground from '../../components/case/ThemePlayground.astro';
import DinoGame from '../../components/case/DinoGame.astro';
import BeforeAfter from '../../components/case/BeforeAfter.astro';
import LayoutBoxes from '../../components/case/LayoutBoxes.astro';
import PytestRun from '../../components/case/PytestRun.astro';
import VideoEmbed from '../../components/case/VideoEmbed.astro';
import { projects, nextProject, projectHref, type CaseStudy } from '../../data/projects';
import { plain, readingMinutes, rich } from '../../utils/rich';
import { pageFontCss } from '../../utils/page-fonts';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CaseStudy;
}

const { project: p } = Astro.props;
const next = nextProject(p.slug);
const pageFonts = p.fonts ? pageFontCss(p.fonts) : null;
const live = p.status === 'Em andamento';

/* Seções presentes, na ordem da página. O número entra no sobretítulo. */
const doVerb = p.type === 'Pesquisa' ? 'O que a pesquisa *cobre*' : p.type === 'Produção técnica' ? 'O que ela *reúne*' : 'O que ele *faz*';
const emphasizeLast = (title: string) => {
  const words = title.split(' ');
  return words.length > 1 ? `${words.slice(0, -1).join(' ')} *${words.at(-1)}*` : `*${title}*`;
};
/* desenho da marca, por projeto (o texto vem dos dados) */
const marks = { extractorys: ExtractorysMark, efipla: EfiplaMark, 'bee-sense': BeeSenseMark } as const;
const Mark = p.art in marks ? marks[p.art as keyof typeof marks] : null;
const hasVisual = Boolean(p.visual && (p.visual.palette || p.visual.appThemes || p.visual.typography || p.visual.tokens || p.visual.gallery || p.visual.mark));
type TabId = 'resumo' | 'pesquisa' | 'ux-ui' | 'construcao' | 'aprendizado';
/* Os tópicos (abas), por área de atuação. Um tópico só aparece se o projeto tem alguma seção dele. */
const tabDefs: { id: TabId; label: string; icon: IconName }[] = [
  { id: 'resumo', label: 'Resumo', icon: 'file-text' },
  { id: 'pesquisa', label: 'Pesquisa e estruturação', icon: 'search' },
  { id: 'ux-ui', label: 'UX/UI', icon: 'pen-tool' },
  { id: 'construcao', label: 'Construção', icon: 'wrench' },
  { id: 'aprendizado', label: 'Aprendizado', icon: 'lightbulb' },
];
const defs = {
  contexto: { label: 'Contexto', title: 'De onde *veio*', on: true },
  funcoes: { label: 'Funções', title: doVerb, on: Boolean(p.features?.length) },
  video: { label: 'Vídeo', title: 'Funcionando de *verdade*', on: Boolean(p.video) },
  resultados: { label: 'Resultados', title: 'O que *ficou*', on: Boolean(p.results) },
  desafio: { label: 'Desafio', title: 'O *problema*', on: Boolean(p.challenge) },
  'por-dentro': { label: 'Por dentro', title: p.inside ? emphasizeLast(p.inside.title) : '', on: Boolean(p.inside) },
  decisoes: { label: 'Decisões', title: 'Escolhas e *porquês*', on: Boolean(p.decisions?.length) },
  'na-pratica': { label: p.demo?.title ?? '', title: p.demo ? emphasizeLast(p.demo.title) : '', on: Boolean(p.demo) },
  visual: { label: 'Visual', title: 'Construção *visual*', on: hasVisual },
  processo: { label: 'Processo', title: 'Como foi *construído*', on: Boolean(p.story?.length) },
  campo: { label: 'Em campo', title: 'Testado no *campo*', on: Boolean(p.fieldwork?.shots.length) },
  tecnologias: { label: 'Tecnologias', title: 'Com o que foi *feito*', on: Boolean(p.tech?.length) },
  habilidades: { label: 'Habilidades', title: 'O que o projeto *ensinou*', on: Boolean(p.skills?.length) },
  aprendizados: { label: 'Aprendizados', title: 'Desafios e *aprendizados*', on: Boolean(p.lessons?.length) },
  proximos: { label: 'Próximos passos', title: 'Próximos *passos*', on: Boolean(p.next?.length) },
  creditos: { label: 'Créditos', title: 'Quem fez *junto*', on: Boolean(p.credits?.length) },
};
type SectionId = keyof typeof defs;
// a demonstração do pytest é rodar os testes: é construção, não interface
const demoInBuild = p.demo?.kind === 'pytest-run';
const groups: Record<TabId, SectionId[]> = {
  resumo: ['contexto', 'funcoes', 'video', 'resultados'],
  pesquisa: ['desafio', 'por-dentro', 'decisoes'],
  'ux-ui': demoInBuild ? ['visual'] : ['na-pratica', 'visual'],
  construcao: demoInBuild ? ['processo', 'campo', 'na-pratica', 'tecnologias'] : ['processo', 'campo', 'tecnologias'],
  aprendizado: ['habilidades', 'aprendizados', 'proximos', 'creditos'],
};
/* Seções presentes, na ordem da página (tópico por tópico). O número entra no sobretítulo. */
const sections = tabDefs.flatMap((t) => groups[t.id].filter((id) => defs[id].on).map((id) => ({ id, tab: t.id, ...defs[id] })));
const tabs = tabDefs.filter((t) => sections.some((s) => s.tab === t.id));
const sectionsOf = (tab: TabId) => sections.filter((s) => s.tab === tab);
const head = (id: SectionId) => {
  const i = sections.findIndex((s) => s.id === id);
  const s = sections[i];
  return { kicker: `${String(i + 1).padStart(2, '0')} — ${s.label}`, title: s.title, id: `${id}-titulo` };
};

const texts = [
  p.tagline,
  ...p.context,
  p.challenge?.problem ?? '',
  ...(p.challenge?.goals ?? []),
  ...(p.story ?? []).flatMap((s) => [s.title, s.text]),
  ...(p.features ?? []).flatMap((f) => [f.title, f.text]),
  p.video?.text ?? '',
  ...(p.inside?.text ?? []),
  ...(p.decisions ?? []).flatMap((d) => [d.title, d.why, d.tradeoff ?? '']),
  p.visual?.intro ?? '',
  p.visual?.appThemesText ?? '',
  p.visual?.mark ?? '',
  p.visual?.galleryNote ?? '',
  p.fieldwork?.text ?? '',
  ...(p.skills ?? []).flatMap((s) => [s.title, s.text]),
  ...(p.results?.highlights ?? []),
  ...(p.lessons ?? []).flatMap((l) => [l.title, l.text]),
  ...(p.next ?? []),
].map(plain);
const minutes = readingMinutes(texts);
const titleWords = p.title.split(' ');
---

<BaseLayout title={`${p.title} · Projetos · Carlos Michael`} description={plain(p.summary)} current="projetos">
  {
    pageFonts && (
      <Fragment slot="head">
        <style is:inline set:html={pageFonts.vars} />
        {/* desligada (media="print") até a seção visual chegar perto; sem JavaScript, carrega já */}
        <style is:inline media="print" data-lazy-fonts set:html={pageFonts.faces} />
        <noscript>
          <style is:inline set:html={pageFonts.faces} />
        </noscript>
      </Fragment>
    )
  }
  <article class="cs" data-case>
    <header class="cs-hero" id="topo" data-tilt-area data-ambient>
      <div class="cs-aura" aria-hidden="true"></div>
      <div class="container">
        <a class="link-arrow cs-back" href="/projetos">
          <Icon name="arrow-left" size={16} />
          Todos os projetos
        </a>
        <div class="cs-hero-grid">
          <div class="cs-hero-text">
            <p class="kicker" data-reveal="fade">{p.type} · {p.period}</p>
            <h1 class="display-xl cs-title" tabindex="-1" style={`view-transition-name:title-${p.slug}`}>
              {titleWords.map((w, i) => (i === titleWords.length - 1 && titleWords.length > 1 ? <em>{w}</em> : <>{w} </>))}
            </h1>
            <p class="cs-tagline" data-reveal style="--i:1">{p.tagline}</p>
            <div class="cs-hero-meta" data-reveal style="--i:2">
              <span class="status" data-live={live ? '' : undefined}>
                <span class="status-dot" aria-hidden="true"></span>
                {p.status}
              </span>
              <span class="cs-read">
                <Icon name="clock" size={15} />
                Leitura de {minutes} min
              </span>
            </div>
            {
              p.links && (
                <div class="cs-links" data-reveal style="--i:3">
                  {p.links.map((link) => (
                    <a class="btn btn-secondary" href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.icon && <Icon name={link.icon} size={17} />}
                      {link.label}
                      <Icon name="arrow-up-right" size={16} class="icon-diagonal" />
                      <span class="sr-only">(abre em nova aba)</span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
          <div class="cs-hero-art">
            <div class="cs-tilt" data-tilt>
              <ProjectArt kind={p.art} size="hero" vt={`art-${p.slug}`} />
            </div>
          </div>
        </div>
        <dl class="cs-facts">
          {
            p.facts.map((f, i) => (
              <div class="cs-fact" data-reveal style={`--i:${i}`}>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <div class="cs-main">
      <div class="cs-tabs-bar" data-tabs-bar>
        <div class="container">
          <nav class="cs-tabs-nav" aria-label="Tópicos do projeto">
            <div class="cs-tabs" data-tablist>
              {
                tabs.map((t) => (
                  <a class="cs-tab" href={`#aba-${t.id}`} data-tab-link={t.id}>
                    <Icon name={t.icon} size={16} />
                    <span>{t.label}</span>
                  </a>
                ))
              }
              <span class="cs-tabs-ink" aria-hidden="true"></span>
            </div>
          </nav>
        </div>
      </div>
    <div class="container cs-layout">
      <aside class="cs-aside">
        <nav class="cs-toc" aria-labelledby="toc-titulo" data-toc>
          <p class="cs-toc-title" id="toc-titulo">
            <Icon name="list" size={16} />
            Nesta página
          </p>
          <ol class="list-reset">
            {
              sections.map((s, i) => (
                <li data-tab={s.tab} data-first={i > 0 && sections[i - 1].tab !== s.tab ? '' : undefined}>
                  <a href={`#${s.id}`} data-toc-link>
                    <span class="cs-toc-n">{String(i + 1).padStart(2, '0')}</span>
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <div class="cs-body">
        {
          tabs.map((t, ti) => {
            const prev = tabs[ti - 1];
            const after = tabs[ti + 1];
            return (
              <div class="cs-panel" id={`aba-${t.id}`} data-panel={t.id}>
                <p class="cs-area" data-reveal="fade">
                  <Icon name={t.icon} size={16} />
                  {t.label}
                </p>
                {sectionsOf(t.id).map((s) => (
                  <>
                  {
                    s.id === 'contexto' && (
                      <section id="contexto" class="cs-section" aria-labelledby="contexto-titulo">
                        <SectionHead {...head('contexto')} size="md" />
                        <div class="cs-prose">
                          {p.context.map((t, i) => <p class:list={{ 'cs-lead': i === 0 }} data-reveal style={`--i:${i}`} set:html={rich(t)} />)}
                        </div>
                      </section>
                    )
                  }
                  {
                    s.id === 'desafio' && p.challenge && (
                      <section id="desafio" class="cs-section" aria-labelledby="desafio-titulo">
                        <SectionHead {...head('desafio')} size="md" />
                        <blockquote class="cs-problem" data-reveal>
                          <Icon name="target" size={26} />
                          <p set:html={rich(p.challenge.problem)} />
                        </blockquote>
                        {p.challenge.goals && (
                          <>
                            <h3 class="cs-sub" data-reveal>
                              Objetivos
                            </h3>
                            <ol class="list-reset cs-goals">
                              {p.challenge.goals.map((g, i) => (
                                <li data-reveal style={`--i:${i}`}>
                                  <span class="cs-goal-n" aria-hidden="true">
                                    {String(i + 1).padStart(2, '0')}
                                  </span>
                                  <span set:html={rich(g)} />
                                </li>
                              ))}
                            </ol>
                          </>
                        )}
                      </section>
                    )
                  }
                  {
                    s.id === 'processo' && p.story && (
                      <section id="processo" class="cs-section" aria-labelledby="processo-titulo">
                        <SectionHead {...head('processo')} size="md" />
                        <ol class="list-reset cs-timeline">
                          {p.story.map((s, i) => (
                            <li class="cs-step" data-reveal style={`--i:${i % 3}`}>
                              <span class="cs-step-dot" aria-hidden="true" />
                              <p class="cs-step-date">{s.date}</p>
                              <h3 class="cs-step-title">{s.title}</h3>
                              <p class="cs-step-text" set:html={rich(s.text)} />
                            </li>
                          ))}
                        </ol>
                      </section>
                    )
                  }
                  {
                    s.id === 'campo' && p.fieldwork && (
                      <section id="campo" class="cs-section" aria-labelledby="campo-titulo">
                        <SectionHead {...head('campo')} size="md" text={p.fieldwork.text} />
                        <Gallery shots={p.fieldwork.shots} label={`Fotos dos testes do projeto ${p.title}`} />
                        {p.fieldwork.note && (
                          <p class="cs-gallery-note" data-reveal>
                            <Icon name="map-pin" size={15} />
                            <span set:html={rich(p.fieldwork.note)} />
                          </p>
                        )}
                      </section>
                    )
                  }
                  {
                    s.id === 'funcoes' && p.features && (
                      <section id="funcoes" class="cs-section" aria-labelledby="funcoes-titulo">
                        <SectionHead {...head('funcoes')} size="md" />
                        <ul class="list-reset cs-features">
                          {p.features.map((f, i) => (
                            <li class="card card-canvas card-lift cs-feature" data-spotlight data-reveal style={`--i:${i % 3}`}>
                              <span class="cs-feature-icon" aria-hidden="true">
                                <Icon name={f.icon} size={22} />
                              </span>
                              <h3 class="cs-feature-title">{f.title}</h3>
                              <p set:html={rich(f.text)} />
                            </li>
                          ))}
                        </ul>
                      </section>
                    )
                  }
                  {
                    s.id === 'video' && p.video && (
                      <section id="video" class="cs-section" aria-labelledby="video-titulo">
                        <SectionHead {...head('video')} size="md" text={p.video.text} />
                        <div data-reveal>
                          <VideoEmbed video={p.video} art={p.art} />
                        </div>
                      </section>
                    )
                  }
                  {
                    s.id === 'por-dentro' && p.inside && (
                      <section id="por-dentro" class="cs-section" aria-labelledby="por-dentro-titulo">
                        <SectionHead {...head('por-dentro')} size="md" />
                        <div class="cs-prose">
                          {p.inside.text.map((t, i) => (
                            <p data-reveal style={`--i:${i}`} set:html={rich(t)} />
                          ))}
                        </div>
                        {p.inside.diagram && (
                          <div class="cs-wide" data-reveal>
                            <ProjectDiagram kind={p.inside.diagram} />
                          </div>
                        )}
                      </section>
                    )
                  }
                  {
                    s.id === 'decisoes' && p.decisions && (
                      <section id="decisoes" class="cs-section" aria-labelledby="decisoes-titulo">
                        <SectionHead {...head('decisoes')} size="md" />
                        <ol class="list-reset cs-decisions">
                          {p.decisions.map((d, i) => (
                            <li class="cs-decision" data-reveal style={`--i:${i % 2}`}>
                              <span class="cs-decision-n" aria-hidden="true" data-n={String(i + 1).padStart(2, '0')} />
                              <h3 class="cs-decision-title" set:html={rich(d.title)} />
                              <p class="cs-decision-why">
                                <span class="cs-label">Por quê</span>
                                <span set:html={rich(d.why)} />
                              </p>
                              {d.tradeoff && (
                                <p class="cs-decision-cost">
                                  <span class="cs-label">Custo</span>
                                  <span set:html={rich(d.tradeoff)} />
                                </p>
                              )}
                            </li>
                          ))}
                        </ol>
                      </section>
                    )
                  }
                  {
                    s.id === 'na-pratica' && p.demo && (
                      <section id="na-pratica" class="cs-section" aria-labelledby="na-pratica-titulo">
                        <SectionHead {...head('na-pratica')} size="md" text={p.demo.text} />
                        <div class="cs-wide" data-reveal>
                          {p.demo.kind === 'dino-game' && <DinoGame />}
                          {p.demo.kind === 'before-after' && p.demo.compare && <BeforeAfter compare={p.demo.compare} />}
                          {p.demo.kind === 'layout-boxes' && <LayoutBoxes />}
                          {p.demo.kind === 'pytest-run' && <PytestRun />}
                        </div>
                      </section>
                    )
                  }
                  {
                    s.id === 'visual' && hasVisual && p.visual && (
                      <section id="visual" class="cs-section" aria-labelledby="visual-titulo">
                        <SectionHead {...head('visual')} size="md" text={p.visual.intro} />
                        {p.visual.palette && (
                          <div class="cs-block">
                            <h3 class="cs-sub" data-reveal>
                              <Icon name="palette" size={18} /> Cores
                            </h3>
                            <Palette swatches={p.visual.palette} gradient={p.visual.gradient} note={p.visual.paletteNote} />
                          </div>
                        )}
                        {p.visual.appThemes && (
                          <div class="cs-block">
                            <h3 class="cs-sub" data-reveal>
                              <Icon name="swatch-book" size={18} /> Destaques e peles
                            </h3>
                            {p.visual.appThemesText && <p class="cs-block-text" data-reveal set:html={rich(p.visual.appThemesText)} />}
                            <div data-reveal>
                              <ThemePlayground themes={p.visual.appThemes} />
                            </div>
                          </div>
                        )}
                        {p.visual.typography && (
                          <div class="cs-block">
                            <h3 class="cs-sub" data-reveal>
                              <Icon name="type" size={18} /> Tipografia
                            </h3>
                            <TypeSpecimens specimens={p.visual.typography} />
                          </div>
                        )}
                        {p.visual.tokens && (
                          <div class="cs-block">
                            <h3 class="cs-sub" data-reveal>
                              <Icon name="layers" size={18} /> Design system
                            </h3>
                            <TypeSpecimens tokens={p.visual.tokens} />
                          </div>
                        )}
                        {p.visual.mark && (
                          <div class="cs-block cs-mark" data-reveal style={p.visual.markBackground ? `--mark-bg:${p.visual.markBackground}` : undefined}>
                            {Mark && (
                              <div class="cs-mark-art" aria-hidden="true">
                                <Mark />
                              </div>
                            )}
                            <div>
                              <h3 class="cs-sub">
                                <Icon name="sparkles" size={18} /> Marca
                              </h3>
                              <p set:html={rich(p.visual.mark)} />
                            </div>
                          </div>
                        )}
                        {p.visual.gallery && (
                          <div class="cs-block">
                            <h3 class="cs-sub" data-reveal>
                              <Icon name="monitor" size={18} /> {p.visual.galleryTitle ?? 'Telas'}
                            </h3>
                            <Gallery shots={p.visual.gallery} label={`${p.visual.galleryTitle ?? 'Telas'} do projeto ${p.title}`} />
                            {p.visual.galleryNote && (
                              <p class="cs-gallery-note" data-reveal>
                                <Icon name="clock" size={15} />
                                <span set:html={rich(p.visual.galleryNote)} />
                              </p>
                            )}
                          </div>
                        )}
                      </section>
                    )
                  }
                  {
                    s.id === 'tecnologias' && p.tech && (
                      <section id="tecnologias" class="cs-section" aria-labelledby="tecnologias-titulo">
                        <SectionHead {...head('tecnologias')} size="md" />
                        <div class="cs-tech">
                          {p.tech.map((group, i) => (
                            <div class="cs-tech-group" data-reveal style={`--i:${i % 4}`}>
                              <h3 class="cs-tech-title">{group.group}</h3>
                              <ul class="chip-list">
                                {group.items.map((item) => (
                                  <li class="chip">{item}</li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </section>
                    )
                  }
                  {
                    s.id === 'habilidades' && p.skills && (
                      <section id="habilidades" class="cs-section" aria-labelledby="habilidades-titulo">
                        <SectionHead {...head('habilidades')} size="md" />
                        <ul class="list-reset cs-skills">
                          {p.skills.map((s, i) => (
                            <li class="cs-skill" data-reveal style={`--i:${i % 3}`}>
                              <Icon name="check" size={18} />
                              <div>
                                <h3 class="cs-skill-title">{s.title}</h3>
                                <p set:html={rich(s.text)} />
                              </div>
                            </li>
                          ))}
                        </ul>
                      </section>
                    )
                  }
                  {
                    s.id === 'resultados' && p.results && (
                      <section id="resultados" class="cs-section" aria-labelledby="resultados-titulo">
                        <SectionHead {...head('resultados')} size="md" />
                        {p.results.metrics && (
                          <ul class="list-reset cs-metrics">
                            {p.results.metrics.map((m, i) => (
                              <li class="cs-metric" data-reveal style={`--i:${i}`}>
                                <span class="cs-metric-value">
                                  {m.prefix}
                                  <span data-count={m.value}>{m.value.toLocaleString('pt-BR')}</span>
                                  {m.suffix}
                                </span>
                                <span class="cs-metric-label">{m.label}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                        {p.results.highlights && (
                          <ul class="list-reset cs-highlights">
                            {p.results.highlights.map((h, i) => (
                              <li data-reveal style={`--i:${i}`}>
                                <Icon name="award" size={18} />
                                <span set:html={rich(h)} />
                              </li>
                            ))}
                          </ul>
                        )}
                      </section>
                    )
                  }
                  {
                    s.id === 'aprendizados' && p.lessons && (
                      <section id="aprendizados" class="cs-section" aria-labelledby="aprendizados-titulo">
                        <SectionHead {...head('aprendizados')} size="md" />
                        <ul class="list-reset cs-lessons">
                          {p.lessons.map((l, i) => (
                            <li class="card card-canvas cs-lesson" data-reveal style={`--i:${i % 2}`}>
                              <Icon name="lightbulb" size={20} />
                              <h3 class="cs-lesson-title">{l.title}</h3>
                              <p set:html={rich(l.text)} />
                            </li>
                          ))}
                        </ul>
                      </section>
                    )
                  }
                  {
                    s.id === 'proximos' && p.next && (
                      <section id="proximos" class="cs-section" aria-labelledby="proximos-titulo">
                        <SectionHead {...head('proximos')} size="md" />
                        <ul class="list-reset cs-next-steps">
                          {p.next.map((n, i) => (
                            <li data-reveal style={`--i:${i}`}>
                              <Icon name="compass" size={18} />
                              <span set:html={rich(n)} />
                            </li>
                          ))}
                        </ul>
                      </section>
                    )
                  }
                  {
                    s.id === 'creditos' && p.credits && (
                      <section id="creditos" class="cs-section" aria-labelledby="creditos-titulo">
                        <SectionHead {...head('creditos')} size="md" />
                        <ul class="list-reset cs-credits">
                          {p.credits.map((c) => (
                            <li class="cs-credit" data-reveal>
                              <span class="cs-credit-avatar" aria-hidden="true">
                                {c.name
                                  .split(' ')
                                  .map((w) => w[0])
                                  .slice(0, 2)
                                  .join('')}
                              </span>
                              <span>
                                {c.href ? (
                                  <a class="text-link" href={c.href} target="_blank" rel="noopener noreferrer">
                                    {c.name}
                                    <span class="sr-only"> (abre em nova aba)</span>
                                  </a>
                                ) : (
                                  <strong>{c.name}</strong>
                                )}
                                <span class="cs-credit-role">{c.role}</span>
                              </span>
                            </li>
                          ))}
                        </ul>
                      </section>
                    )
                  }
                  </>
                ))}
                <nav class="cs-tabnav" aria-label={`Fim da aba ${t.label}`} data-reveal>
                  {prev && (
                    <a class="btn btn-secondary cs-tabnav-btn cs-tabnav-prev" href={`#aba-${prev.id}`} data-tab-go={prev.id}>
                      <Icon name="arrow-left" size={18} class="icon-back" />
                      <span class="cs-tabnav-text">
                        <span class="cs-tabnav-small">Aba anterior</span>
                        {prev.label}
                      </span>
                    </a>
                  )}
                  <a class="btn btn-secondary cs-tabnav-btn cs-tabnav-top" href="#topo" data-to-top>
                    <Icon name="arrow-up" size={18} class="icon-up" />
