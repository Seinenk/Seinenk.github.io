    gap: 0.45rem;
    min-height: 2.5rem;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    padding: 0.4rem 1rem 0.4rem 0.8rem;
    border: 1px solid var(--c-inverse-hairline);
    border-radius: var(--radius-pill);
    background: rgb(var(--c-on-inverse-rgb) / 0.04);
    color: var(--c-on-inverse-soft);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .lp-back:hover {
    border-color: rgb(var(--c-on-inverse-rgb) / 0.4);
    background: rgb(var(--c-on-inverse-rgb) / 0.08);
    color: var(--c-on-inverse);
  }

  .lp-back :global(.icon) {
    transition: transform 0.45s var(--ease-out);
  }

  .lp-back:hover :global(.icon) {
    transform: translateX(-4px);
  }

  .lp-back:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  .cs-hero-grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .cs-hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }

  /* selo do alto: situação, tipo e período */
  .lp-eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    padding: 0.4rem 0.95rem 0.4rem 0.75rem;
    border: 1px solid var(--c-inverse-hairline);
    border-radius: var(--radius-pill);
    background: rgb(var(--c-on-inverse-rgb) / 0.06);
    color: var(--c-on-inverse-soft);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .lp-eyebrow .status {
    color: var(--c-on-inverse);
  }

  .lp-eyebrow .status-dot {
    background: var(--c-inverse-accent);
    box-shadow: 0 0 0 3px rgb(var(--c-inverse-accent-rgb) / 0.2);
  }

  .lp-eyebrow .status[data-live] .status-dot {
    background: var(--c-inverse-cyan);
  }

  .lp-eyebrow-sep {
    width: 1px;
    height: 0.95em;
    background: var(--c-inverse-hairline);
  }

  .cs-title {
    margin-block: 1.1rem 1.1rem;
    color: var(--c-on-inverse);
    overflow-wrap: anywhere;
  }

  .cs-title em {
    color: var(--c-inverse-accent);
  }

  .cs-tagline {
    max-width: 34rem;
    color: var(--c-on-inverse-soft);
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.6;
  }

  .cs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  /* botão principal claro sobre o cartão escuro, com um halo nas cores do projeto */
  .lp-btn-light {
    --btn-bg: var(--c-on-inverse);
    --btn-fg: var(--c-inverse);
    --btn-border: transparent;
    font-weight: 600;
  }

  .lp-btn-light:is(:hover, :focus-visible) {
    --btn-bg: #fff;
    box-shadow:
      0 0 0 4px rgb(var(--c-on-inverse-rgb) / 0.14),
      0 1rem 2.5rem -1rem color-mix(in srgb, var(--brand-a) 75%, transparent);
  }

  .cs-links :global(.btn):focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  /* temas do projeto em pílulas de contorno */
  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .cs-tags li {
    padding: 0.35rem 0.85rem;
    border: 1px solid rgb(var(--c-on-inverse-rgb) / 0.2);
    border-radius: var(--radius-pill);
    color: var(--c-on-inverse-soft);
    font-size: var(--fs-caption-upper);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      border-color 0.3s ease,
      color 0.3s ease,
      background-color 0.3s ease;
  }

  .cs-tags li:nth-child(3n + 1) {
    border-color: rgb(var(--c-cyan-rgb) / 0.45);
  }

  .cs-tags li:nth-child(3n + 2) {
    border-color: rgb(var(--c-violet-rgb) / 0.45);
  }

  @media (hover: hover) {
    .cs-tags li:hover {
      background: rgb(var(--c-on-inverse-rgb) / 0.08);
      color: var(--c-on-inverse);
    }
  }

  .cs-read {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    color: var(--c-on-inverse-soft);
    font-size: var(--fs-caption);
    font-weight: 500;
  }

  .cs-hero-art {
    perspective: 1400px;
  }

  /* moldura de vidro em volta da arte, como a tela de um produto em destaque */
  .lp-art-frame {
    position: relative;
    padding: clamp(0.4rem, 0.3rem + 0.5vw, 0.75rem);
    border: 1px solid rgb(var(--c-on-inverse-rgb) / 0.14);
    border-radius: calc(var(--radius-xl) + clamp(0.4rem, 0.3rem + 0.5vw, 0.75rem));
    background: rgb(var(--c-on-inverse-rgb) / 0.05);
    box-shadow:
      inset 0 1px 0 rgb(var(--c-on-inverse-rgb) / 0.12),
      0 2.5rem 5rem -2.5rem rgb(0 0 0 / 0.7);
  }

  .cs-tilt {
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 0.6s var(--ease-out);
  }

  /* fichas do projeto numa faixa de vidro no pé do cartão */
  .lp-facts-bar {
    border-top: 1px solid var(--c-inverse-hairline);
    background: color-mix(in srgb, var(--c-inverse) 84%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .cs-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-block: 0;
  }

  .cs-fact {
    position: relative;
    padding: 1.15rem 0 1.25rem;
  }

  .cs-fact + .cs-fact {
    border-top: 1px solid var(--c-inverse-hairline);
  }

  /* todo projeto tem 4 fichas: 2 por linha no tablet, as 4 lado a lado no computador */
  @media (min-width: 34rem) {
    .cs-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cs-fact {
      padding-inline: 1.25rem;
    }

    .cs-fact:nth-child(odd) {
      padding-inline-start: 0;
    }

    .cs-fact + .cs-fact {
      border-top: 0;
    }

    .cs-fact:nth-child(even) {
      border-inline-start: 1px solid var(--c-inverse-hairline);
    }

    .cs-fact:nth-child(n + 3) {
      border-top: 1px solid var(--c-inverse-hairline);
    }
  }

  @media (min-width: 64rem) {
    .cs-facts {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }

    .cs-fact,
    .cs-fact:nth-child(n + 3) {
      padding: 1.4rem 1.5rem 1.6rem;
      border-top: 0;
    }

    .cs-fact:first-child {
      padding-inline-start: 0;
    }

    .cs-fact + .cs-fact {
      border-inline-start: 1px solid var(--c-inverse-hairline);
    }
  }

  /* um fio colorido corre pelo alto de cada ficha no hover */
  .cs-fact::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.25rem;
    height: 2px;
    background: linear-gradient(90deg, var(--brand-a), var(--brand-b));
    transition: width 0.7s var(--ease-out);
  }

  @media (min-width: 34rem) {
    .cs-fact:nth-child(even)::before {
      left: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .cs-fact::before,
    .cs-fact:nth-child(even)::before {
      left: 1.5rem;
    }

    .cs-fact:first-child::before {
      left: 0;
    }
  }

  @media (hover: hover) {
    .cs-fact:hover::before {
      width: calc(100% - 1.5rem);
    }
  }

  .cs-fact dt {
    margin-bottom: 0.35rem;
    color: var(--c-inverse-accent);
    font-size: var(--fs-caption-upper);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cs-fact dd {
    margin: 0;
    color: var(--c-on-inverse);
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* ================= faixa das ferramentas (letreiro) ================= */
  .lp-ticker {
    padding-block: clamp(1.5rem, 1.25rem + 1vw, 2.25rem) 0;
  }

  .lp-ticker-inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  .lp-ticker-label {
    flex: none;
    color: var(--c-muted);
    font-size: var(--fs-caption-upper);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lp-ticker-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .lp-ticker-track {
    display: flex;
    width: max-content;
  }

  /* cada item leva o espaço depois dele, então as duas metades da faixa medem o mesmo */
  .lp-ticker-track li {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
    padding-inline-end: clamp(1.25rem, 1rem + 1vw, 2rem);
    color: var(--c-body-strong);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem);
    font-style: italic;
    white-space: nowrap;
  }

  .lp-ticker-track li::after {
    content: '';
    width: 0.85rem;
    height: 0.85rem;
    background: linear-gradient(135deg, var(--c-cyan), var(--c-violet));
    -webkit-mask: var(--glyph-asterisk) center / contain no-repeat;
    mask: var(--glyph-asterisk) center / contain no-repeat;
  }

  :global(:root[data-motion='full']) .lp-ticker-track {
    animation: marquee 48s linear infinite;
  }

  @media (hover: hover) {
    .lp-ticker:hover .lp-ticker-track {
      animation-play-state: paused;
    }
  }

  /* ================= índice das seções (trilho na borda direita) ================= */
  .cs-aside {
    display: none;
  }

  @media (min-width: 86rem) {
    .cs-aside {
      position: fixed;
      top: 50%;
      right: 0.75rem;
      z-index: 25;
      display: block;
      translate: 0 -50%;
      transition:
        opacity 0.4s ease,
        translate 0.5s var(--ease-out);
    }

    /* fora das seções (no topo e no fim), o trilho sai de cena; com o foco do teclado, volta */
    .cs-aside.is-away:not(:focus-within) {
      opacity: 0;
      translate: 1.25rem -50%;
      pointer-events: none;
    }
  }

  .cs-toc {
    position: relative;
    padding: 0.5rem 0.4rem;
    border: 1px solid var(--c-hairline);
    border-radius: 1rem;
    background: rgb(var(--c-canvas-rgb) / 0.86);
    -webkit-backdrop-filter: saturate(1.3) blur(14px);
    backdrop-filter: saturate(1.3) blur(14px);
    box-shadow: var(--shadow-md);
  }

  .cs-toc-title {
    display: grid;
    place-items: center;
    padding: 0.2rem 0 0.45rem;
    color: var(--c-muted);
  }

  .cs-toc-title span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cs-toc li[data-first] {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--c-hairline-soft);
  }

  .cs-toc a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    min-height: 1.75rem;
    padding: 0.15rem 0.4rem;
    border-radius: 0.6rem;
    color: var(--c-muted);
    font-size: var(--fs-caption);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      gap 0.4s var(--ease-out);
  }

  .cs-toc-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  /* o nome da seção abre ao passar o ponteiro, com o foco do teclado e na seção atual */
  .cs-toc-label {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-width 0.45s var(--ease-out),
      opacity 0.3s ease;
  }

  .cs-toc:is(:hover, :focus-within) a,
  .cs-toc a.is-active {
    gap: 0.6rem;
  }

  .cs-toc:is(:hover, :focus-within) .cs-toc-label,
  .cs-toc a.is-active .cs-toc-label {
    max-width: 14rem;
    opacity: 1;
  }

  .cs-toc a:hover {
    color: var(--c-ink);
    background: var(--c-surface-soft);
  }

  .cs-toc a.is-active {
    background: var(--c-primary);
    color: var(--c-on-primary);
    font-weight: 600;
  }

  .cs-toc a:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 1px;
  }

  /* ================= faixas (seções) ================= */
  .cs-main :global(strong) {
    color: var(--lp-ink);
    font-weight: 600;
  }

  .cs-main :is(p, h3, span, li) :global(code) {
    padding: 0.05em 0.35em;
    border-radius: var(--radius-xs);
    background: var(--c-surface-card);
    color: var(--c-ink);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .lp-band {
    --lp-card: var(--c-surface-soft);
    --lp-card-hover: var(--c-surface-card);
    --lp-line: var(--c-hairline);
    --lp-ink: var(--c-ink);
    --lp-body: var(--c-body);
    --lp-muted: var(--c-muted);
    --lp-label: var(--c-accent-strong);
    position: relative;
    padding-block: clamp(3.75rem, 2.75rem + 4vw, 6.75rem);
    background: var(--c-canvas);
    /* o html já desconta o menu (scroll-padding-top); a faixa encosta logo abaixo da barra */
    scroll-margin-top: calc(var(--tabs-h) - 1.5rem);
  }

  .lp-band[data-tone='soft'] {
    --lp-card: var(--c-canvas);
    --lp-card-hover: var(--c-surface-raised);
    background: var(--c-surface-soft);
  }

  .lp-band[data-tone='inverse'] {
    --lp-card: rgb(var(--c-on-inverse-rgb) / 0.045);
    --lp-card-hover: rgb(var(--c-on-inverse-rgb) / 0.08);
    --lp-line: var(--c-inverse-hairline);
    --lp-ink: var(--c-on-inverse);
    --lp-body: var(--c-on-inverse-soft);
    --lp-muted: var(--c-on-inverse-soft);
    --lp-label: var(--c-inverse-accent);
    background: var(--c-inverse);
  }

  .lp-band[data-tone='inverse'] :is(p, h3, span, li) :global(code) {
    background: var(--c-inverse-elevated);
    color: var(--c-on-inverse);
  }

  .cs-panel {
    scroll-margin-top: calc(var(--tabs-h) - 1.5rem);
  }

  .lp-band :global(.section-head) {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .lp-band :global(.section-head.lp-head-center) {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .lp-band :global(.section-head.lp-head-center > p:last-child:not(.kicker)) {
    margin-inline: auto;
  }

  /* abertura de cada tópico: o nome numa pílula, um fio e a posição (01 / 05) */
  .lp-chapter {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  .cs-area {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--radius-pill);
    background: var(--lp-card);
    color: var(--lp-ink);
    font-size: var(--fs-caption-upper);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cs-area :global(svg) {
    color: var(--lp-label);
  }

  .lp-chapter-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--lp-line), transparent);
  }

  .lp-chapter-n {
    flex: none;
    color: var(--lp-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
  }

  /* no celular estreito, sai o fio: a pílula e a posição dividem a linha */
  @media (max-width: 29.99rem) {
    .lp-chapter {
      justify-content: space-between;
      gap: 0.75rem;
    }

    .lp-chapter-line {
      display: none;
    }

    .cs-area {
      flex: 0 1 auto;
      min-width: 0;
      letter-spacing: 0.06em;
    }
  }

  /* o último bloco de cada tópico encosta na navegação do fim do tópico */
  .cs-panel > .cs-section:nth-last-child(2) {
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .cs-prose {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    color: var(--lp-body);
    font-size: var(--fs-body-lg);
    line-height: 1.7;
  }

  .cs-wide {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .cs-sub {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    color: var(--lp-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-title-lg);
    font-weight: 600;
  }

  .cs-label {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--lp-label);
    font-size: var(--fs-caption-upper);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ---------- duas colunas: título à esquerda (preso na rolagem) e texto à direita ---------- */
  .lp-split {
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 60rem) {
    .lp-split {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 1rem + 4vw, 6rem);
      align-items: start;
    }

    .lp-split-head {
      position: sticky;
      top: calc(var(--nav-h) + var(--tabs-h) + 2rem);
    }

    .lp-split :global(.section-head) {
      margin-bottom: 0;
    }
  }

  /* o primeiro parágrafo do contexto vira a frase de abertura, grande, em serifa */
  .cs-lead {
    color: var(--lp-ink);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.2rem + 1vw, 1.95rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .cs-lead + p {
    margin-top: 0.5rem;
  }

  /* ---------- funções: mosaico (bento) ---------- */
  .cs-features {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  @media (min-width: 52rem) {
    .cs-features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* o cartão grande: ícone no alto, título e texto no pé */
    .cs-feature:first-child {
      grid-column: span 2;
      grid-row: span 2;
      grid-template-rows: 1fr auto auto;
      align-content: stretch;
      min-height: 22rem;
    }

    .cs-feature:first-child .cs-feature-icon {
      align-self: start;
    }

    .cs-feature:first-child .cs-feature-title {
      font-family: var(--font-display);
      font-size: var(--fs-display-sm);
      font-weight: 500;
    }

    .cs-feature:first-child p {
      max-width: 34rem;
      font-size: var(--fs-body-md);
    }

    /*
     * Com a primeira ocupando 2 x 2, as outras enchem linhas de 3. A última linha sempre
     * fecha: sobrando uma função, ela ocupa a linha toda; sobrando duas, a penúltima ocupa 2.
     */
    .cs-feature:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }

    .cs-features:has(> .cs-feature:nth-child(3n + 2):last-child) > .cs-feature:nth-last-child(2):not(:first-child) {
      grid-column: span 2;
    }
  }

  .cs-feature {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.65rem;
    overflow: hidden;
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
  }

  .cs-feature > :not(.cs-feature-n) {
    position: relative;
    z-index: 1;
  }

  /* o cartão grande ganha anéis concêntricos atrás, como uma onda saindo do ícone */
  .cs-feature:first-child {
    background:
      radial-gradient(80% 90% at 100% 0%, rgb(var(--c-cyan-rgb) / 0.14), transparent 60%),
      radial-gradient(70% 80% at 0% 100%, rgb(var(--c-violet-rgb) / 0.1), transparent 60%),
      var(--lp-card);
  }

  /* os anéis saem do ícone, no canto de cima */
  .cs-feature:first-child::after {
    content: '';
    position: absolute;
    top: -11rem;
    left: -11rem;
    z-index: 0;
    width: 30rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, transparent 0 1.9rem, rgb(var(--c-ink-rgb) / 0.08) 1.9rem calc(1.9rem + 1px));
    mask-image: radial-gradient(closest-side, #000 30%, transparent);
    pointer-events: none;
  }

  :global(:root[data-motion='full']) .cs-feature:first-child::after {
    animation: spin 90s linear infinite;
  }

  .cs-feature-n {
    position: absolute;
    z-index: 1;
    top: 1.1rem;
    right: 1.35rem;
    color: var(--lp-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }

  .cs-feature-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.35rem;
    border-radius: 0.95rem;
    background: linear-gradient(135deg, var(--c-cyan-soft), var(--c-violet-soft));
    box-shadow: inset 0 0 0 1px var(--lp-line);
    color: var(--c-cyan-strong);
    transition:
      transform 0.5s var(--ease-spring),
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .cs-feature:nth-child(even) .cs-feature-icon {
    color: var(--c-violet-strong);
  }

  .cs-feature:first-child .cs-feature-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 1.2rem;
  }

  .cs-feature:hover .cs-feature-icon {
    transform: rotate(-8deg) scale(1.08);
    background: var(--c-primary);
    color: var(--c-on-primary);
  }

  .cs-feature-title {
    color: var(--lp-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-title-md);
    font-weight: 600;
  }

  .cs-feature p {
    color: var(--lp-body);
    font-size: var(--fs-body-sm);
  }

  @media (hover: hover) and (pointer: fine) {
    .cs-feature.card-lift:hover {
      border-color: var(--c-outline);
      box-shadow: var(--shadow-md);
    }
  }

  /* ---------- palco: a demonstração e o vídeo num fundo de vitrine ---------- */
  .lp-stage {
    position: relative;
    isolation: isolate;
    padding: clamp(0.75rem, 0.25rem + 2.2vw, 2.5rem);
    border: 1px solid var(--lp-line);
    border-radius: calc(var(--lp-radius) + 0.25rem);
    background:
      radial-gradient(70% 60% at 0% 0%, rgb(var(--c-cyan-rgb) / 0.1), transparent 65%),
      radial-gradient(70% 60% at 100% 100%, rgb(var(--c-violet-rgb) / 0.1), transparent 65%),
      var(--lp-card);
    box-shadow: var(--shadow-md);
  }

  .lp-stage-video {
    max-width: 62rem;
    margin-inline: auto;
  }

  /* ---------- desafio: o problema num cartão escuro e os objetivos ao lado ---------- */
  .lp-problem-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 60rem) {
    .lp-problem-grid.has-goals {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      align-items: start;
    }

    .lp-problem-grid.has-goals .cs-problem {
      position: sticky;
      top: calc(var(--nav-h) + var(--tabs-h) + 2rem);
    }
  }

  .cs-problem {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: clamp(1.5rem, 1.1rem + 2vw, 2.75rem);
    border: 1px solid var(--c-inverse-hairline);
    border-radius: var(--lp-radius);
    background:
      radial-gradient(90% 80% at 100% 0%, color-mix(in srgb, var(--brand-a) 22%, transparent), transparent 60%),
      var(--c-inverse);
    color: var(--c-on-inverse);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem);
    line-height: 1.38;
  }

  .cs-problem :global(.icon) {
    margin-top: 0.3rem;
    color: var(--c-inverse-accent);
  }

  .cs-problem :global(strong) {
    color: var(--c-on-inverse);
  }

  .cs-problem :global(code) {
    background: var(--c-inverse-elevated) !important;
    color: var(--c-on-inverse) !important;
  }

  .lp-goals .cs-sub {
    margin-bottom: 1rem;
  }

  .cs-goals {
    display: grid;
    gap: 0.75rem;
  }

  .cs-goals li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.05rem 1.2rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
    color: var(--lp-body);
    transition:
      border-color 0.3s ease,
      translate 0.5s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cs-goals li:hover {
      translate: 0.35rem 0;
      border-color: var(--c-outline);
    }
  }

  .cs-goal-n {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--c-primary);
    color: var(--c-on-primary);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }

  /* ---------- processo (linha do tempo) ---------- */
  .cs-timeline {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-inline-start: 2rem;
  }

  .cs-timeline::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.45rem;
    width: 2px;
    background: var(--lp-line);
  }

  /* a linha se preenche conforme a leitura avança */
  .cs-timeline::after {
    content: '';
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.45rem;
    width: 2px;
    background: var(--c-accent-strong);
    transform-origin: top;
    transform: scaleY(1);
  }

  @supports (animation-timeline: view()) {
    :global(:root[data-motion='full']) .cs-timeline::after {
      animation: grow-y linear both;
      animation-timeline: view();
      animation-range: entry 30% cover 60%;
    }
  }

  .cs-step {
    position: relative;
  }

  .cs-step-dot {
    position: absolute;
    left: -2rem;
    top: 0.25rem;
    width: 0.95rem;
    height: 0.95rem;
    border: 2px solid var(--c-accent-strong);
    border-radius: 50%;
    background: var(--c-canvas);
    transition: background-color 0.4s ease 0.3s;
  }

  .cs-step:global(.is-visible) .cs-step-dot {
    background: var(--c-accent-strong);
  }

  .cs-step-date {
    color: var(--lp-label);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }

  .cs-step-title {
    margin: 0.2rem 0 0.4rem;
    color: var(--lp-ink);
    font-family: var(--font-display);
    font-size: var(--fs-title-lg);
    font-weight: 500;
  }

  .cs-step-text {
    max-width: 42rem;
    color: var(--lp-body);
  }

  /* telas largas: o caminho tracejado no meio, com as etapas em cartões dos dois lados */
  @media (min-width: 52rem) {
    .cs-timeline {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 4.5rem;
      row-gap: 0;
      padding-inline-start: 0;
    }

    .cs-timeline::before {
      left: 50%;
      width: 0;
      translate: -1px 0;
      background: none;
      border-left: 2px dashed var(--lp-line);
    }

    .cs-timeline::after {
      left: 50%;
      translate: -1px 0;
      background: linear-gradient(var(--c-accent-strong), var(--c-cyan) 70%, var(--c-violet));
    }

    .cs-step {
      grid-column: 1;
      align-self: start;
      margin-bottom: 1.25rem;
      padding: 1.25rem 1.45rem 1.35rem;
      border: 1px solid var(--lp-line);
      border-radius: var(--lp-card-radius);
      background: var(--lp-card);
      transition:
        border-color 0.3s ease,
        box-shadow 0.5s var(--ease-out),
        translate 0.5s var(--ease-out);
    }

    .cs-step:nth-child(even) {
      grid-column: 2;
      margin-top: 4.5rem;
    }

    /* ponto no caminho e um traço até o cartão */
    .cs-step-dot {
      left: auto;
      right: calc(-2.25rem - 0.475rem);
      top: 1.4rem;
    }

    .cs-step:nth-child(even) .cs-step-dot {
      right: auto;
      left: calc(-2.25rem - 0.475rem);
    }

    .cs-step::before {
      content: '';
      position: absolute;
      top: calc(1.4rem + 0.475rem);
      right: -2.25rem;
      width: 2.25rem;
      border-top: 1px dashed var(--c-outline);
    }

    .cs-step:nth-child(even)::before {
      right: auto;
      left: -2.25rem;
    }

    .cs-step-text {
      font-size: var(--fs-body-sm);
    }
  }

  @media (min-width: 52rem) and (hover: hover) and (pointer: fine) {
    .cs-step:hover {
      translate: 0 -3px;
      border-color: var(--c-outline);
      box-shadow: var(--shadow-md);
    }
  }

  /*
   * ---------- coleções de cartões ----------
   * Linhas de cartões da mesma altura; a última linha, quando sobra, fica centralizada e com
   * a mesma largura das outras (--per-row vem da página, conforme a quantidade).
   */
  .lp-flow {
    --gap: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }

  .lp-flow > :global(*) {
    flex: 0 1 100%;
    min-width: 0;
  }

  @media (min-width: 40rem) {
    .lp-flow > :global(*) {
      flex-basis: calc((100% - var(--gap)) / 2);
    }
  }

  @media (min-width: 64rem) {
    .lp-flow > :global(*) {
      flex-basis: calc((100% - (var(--per-row, 3) - 1) * var(--gap)) / var(--per-row, 3));
    }
  }

  /* ---------- decisões ---------- */
  .cs-decision {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    overflow: hidden;
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
    transition:
      border-color 0.3s ease,
      box-shadow 0.5s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cs-decision:hover {
      border-color: var(--c-outline);
      box-shadow: var(--shadow-md);
    }
  }

  .cs-decision-n::after {
    content: attr(data-n);
  }

  .cs-decision-n {
    position: absolute;
    top: -0.6rem;
    right: 0.6rem;
    color: rgb(var(--c-accent-rgb) / 0.2);
    font-family: var(--font-display);
    font-size: 4.75rem;
    font-style: italic;
    line-height: 1;
    pointer-events: none;
    transition: transform 0.6s var(--ease-out);
  }

  .cs-decision:hover .cs-decision-n {
    transform: translateY(6px) rotate(-6deg);
  }

  .cs-decision-title {
    padding-inline-end: 3rem;
    color: var(--lp-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-title-md);
    font-weight: 600;
  }

  .cs-decision-why,
  .cs-decision-cost {
    color: var(--lp-body);
    font-size: var(--fs-body-sm);
  }

  .cs-decision-cost {
    padding-top: 0.75rem;
    border-top: 1px dashed var(--lp-line);
  }

  /* ---------- visual: um quadro da marca em painéis ---------- */
  .lp-board {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }

  .lp-panel {
    min-width: 0;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius);
    background: var(--lp-card);
  }

  /* no celular, painéis e palco vão de ponta a ponta: o conteúdo ganha a largura toda */
  @media (max-width: 39.99rem) {
    .lp-panel,
    .lp-stage {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      border-inline: 0;
      border-radius: 0;
    }
  }

  .lp-screens {
    min-width: 0;
    margin-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  .cs-sub :global(.icon) {
    flex: none;
    box-sizing: content-box;
    padding: 0.45rem;
    border-radius: 0.7rem;
    background: linear-gradient(135deg, var(--c-cyan-soft), var(--c-violet-soft));
    color: var(--c-cyan-strong);
  }

  .cs-mark {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: var(--lp-radius);
    background: var(--mark-bg, linear-gradient(135deg, #2a0048, #800080 45%, #d50048));
    color: #f3f1ea;
  }

  .cs-mark .cs-sub {
    color: #fff;
  }

  .cs-mark .cs-sub :global(.icon) {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .cs-mark p {
    max-width: 44rem;
    color: #f3f1ea;
  }

  .cs-mark :global(strong) {
    color: #fff;
  }

  /* a coluna do desenho só existe quando o projeto tem um desenho da marca */
  @media (min-width: 40rem) {
    .cs-mark-art-on {
      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }

  .cs-mark-art {
    width: 10rem;
    justify-self: center;
  }

  .cs-block-text {
    max-width: 44rem;
    margin-bottom: 1.25rem;
    color: var(--lp-body);
  }

  .cs-gallery-note {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    max-width: 44rem;
    margin-top: 1rem;
    color: var(--lp-muted);
    font-size: var(--fs-caption);
  }

  .lp-campo .cs-gallery-note {
    margin-inline: auto;
  }

  .cs-gallery-note :global(svg) {
    flex: none;
    margin-top: 0.2em;
  }

  /* rótulos do passo a passo e da galeria completa, dentro do bloco de telas */
  .cs-story-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.25rem 0 1rem;
    color: var(--lp-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-caption-upper);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cs-story-label :global(.icon) {
    color: var(--c-cyan-strong);
  }

  /* ---------- tecnologias (faixa escura) ---------- */
  .cs-tech-group {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  @media (hover: hover) {
    .cs-tech-group:hover {
      background: var(--lp-card-hover);
    }
  }

  .lp-band .cs-tech-title {
    margin-bottom: 0.85rem;
    color: var(--lp-label);
    font-family: var(--font-sans);
    font-size: var(--fs-caption-upper);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cs-tech .chip {
    transition:
      transform 0.4s var(--ease-spring),
      border-color 0.3s ease;
  }

  .cs-tech .chip:hover {
    transform: translateY(-2px);
    border-color: var(--c-outline);
  }

  .band-inverse .cs-tech .chip:hover {
    border-color: var(--c-on-inverse-soft);
  }

  /* ---------- habilidades ---------- */
  .cs-skill {
    display: flex;
    gap: 0.9rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
  }

  .cs-skill > :global(.icon) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    padding: 0.22rem;
    border-radius: 50%;
    background: var(--c-primary);
    color: var(--c-on-primary);
  }

  .cs-skill-title {
    margin-bottom: 0.25rem;
    color: var(--lp-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-title-sm);
    font-weight: 600;
  }

  .cs-skill p {
    color: var(--lp-body);
    font-size: var(--fs-body-sm);
  }

  /* ---------- resultados: os números numa faixa escura ---------- */
  .cs-metrics-wrap {
    container-type: inline-size;
    margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  /* fios entre os números: a grade tem 1px de vão sobre o fundo da linha */
  .cs-metrics {
    display: grid;
    gap: 1px;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius);
    background: var(--lp-line);
  }

  @container (min-width: 30rem) {
    .cs-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cs-metrics:has(> :nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container (min-width: 50rem) {
    .cs-metrics {
      grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    }
  }

  .cs-metric {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.6rem;
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.75rem) clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
    background: var(--c-inverse);
    text-align: center;
    transition: background-color 0.4s ease;
  }

  .lp-band:not([data-tone='inverse']) .cs-metric {
    background: var(--lp-card);
  }

  @media (hover: hover) {
    .lp-band[data-tone='inverse'] .cs-metric:hover {
      background: color-mix(in srgb, var(--c-inverse) 88%, var(--c-on-inverse));
    }
  }

  .cs-metric-badge {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--lp-line);
    border-radius: 50%;
    color: var(--c-cyan);
  }

  .cs-metric:nth-child(even) .cs-metric-badge {
    color: var(--c-violet);
  }

  .cs-metric-value {
    color: var(--lp-ink);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cs-metric-value em {
    font-size: 0.6em;
    font-style: italic;
    /* o tom forte do destaque: no celular a unidade fica abaixo de 24px e precisa de 4,5:1 */
    color: var(--lp-label);
  }

  .cs-metric-label {
    max-width: 16rem;
    color: var(--lp-muted);
    font-size: var(--fs-body-sm);
    text-wrap: pretty;
  }

  .cs-highlights li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
    color: var(--lp-body);
  }

  .cs-highlights :global(.icon) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--lp-label);
  }

  /* ---------- depoimentos do projeto ---------- */
  .cs-quotes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 34rem));
    justify-content: center;
  }

  .cs-quote-long {
    grid-column: 1 / -1;
    justify-self: center;
    max-width: 46rem;
  }

  /* ---------- aprendizados ---------- */
  .cs-lesson {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
  }

  .cs-lesson > :global(.icon) {
    box-sizing: content-box;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, var(--c-cyan-soft), var(--c-violet-soft));
    color: var(--c-accent-strong);
  }

  .cs-lesson-title {
    color: var(--lp-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-title-md);
    font-weight: 600;
  }

  .cs-lesson p {
    color: var(--lp-body);
    font-size: var(--fs-body-sm);
  }

  /* ---------- próximos passos: um roteiro em cartões ---------- */
  .cs-next-steps li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.3rem 1.4rem 1.4rem;
    border: 1px dashed var(--c-outline);
    border-radius: var(--lp-card-radius);
    background: var(--lp-card);
    color: var(--lp-body);
    transition:
      border-style 0.3s ease,
      translate 0.5s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cs-next-steps li:hover {
      translate: 0 -3px;
      border-style: solid;
    }
  }

  .cs-next-steps :global(.icon) {
